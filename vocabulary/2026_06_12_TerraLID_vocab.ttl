:c_1c8f3d46 a skos:Concept;
  skos:definition "The standard error of the mean (SEM) is data item denoting the standard deviation of the sample-mean's estimate of a population mean. It is calculated by dividing the sample standard deviation (i.e., the sample-based estimate of the standard deviation of the population) by the square root of n , the size (number of observations) of the sample. A measure of dispersion applied to means across hypothetical repeated random samples."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "standard error"@en;
  skos:altLabel "SE"@en;
  skos:note "The definition of this entry is taken from STATO - The Statistical Methods Ontology, published under a Creative Commons Attribution 3.0 (CC-BY 3.0) license. "@en;
  skos:broader :c_6ae288a3;
  skos:exactMatch <http://purl.obolibrary.org/obo/STATO_0000037>, <https://www.wikidata.org/wiki/Q620994> .

:c_ed11712a a skos:Concept;
  skos:definition "The standard deviation of a random variable, statistical population, data set, or probability distribution is a measure of variation which correspond to the average distance from the mean of the data set to any given point of that dataset. It also corresponds to the square root of its variance."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "standard deviation"@en;
  skos:altLabel "SD"@en;
  skos:note "The definition of this entry are taken from STATO - The Statistical Methods Ontology, published under a Creative Commons Attribution 3.0 (CC-BY 3.0) license. "@en;
  skos:broader :c_6ae288a3;
  skos:exactMatch <http://purl.obolibrary.org/obo/STATO_0000237>, <https://www.wikidata.org/wiki/Q159375> .

:c_c8cb9106 a skos:Concept;
  skos:definition "A string unique for a specific resource or feature. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "identifier"@en;
  skos:note "This is a reproduction of the controlled list relatedIdentifierType in the DataCite Metadata version schema 4.7. "@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000022>;
  skos:exactMatch <https://www.wikidata.org/wiki/Q853614>;
  dct:modified "2026-06-13T00:09:50"^^xsd:dateTime .

:c_f260a576 a skos:Concept;
  skos:definition "Mostly used to publish vocabularies and ontologies. The letters ‘w3’ stand for “World Wide Web”."@en;
  skos:example "https://w3id.org/games/spec/coil#Coil_Bomb_Die_Of_Age"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "w3id"@en;
  skos:altLabel "Permanent identifier for Web applications"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#w3id> .

:c_efbf8c56 a skos:Concept;
  skos:definition "A unique and persistent identifier of an electronic document. The syntax is: urn:<NID>:<NSS>. The leading urn: sequence is case-insensitive, <NID> is the namespace identifier, <NSS> is the namespace-specific string."@en;
  skos:example "urn:nbn:de:101:1-201102033592"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "URN"@en;
  skos:altLabel "Uniform Resource Name"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q76497>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#urn> .

:c_cca94dd2 a skos:Concept;
  skos:definition "Also known as web address, a URL is a specific character string that constitutes a reference to a resource. The syntax is: scheme://domain:port/path?query_string#fragment_id."@en;
  skos:example "http://www.heatflow.und.edu/index2.html"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "URL"@en;
  skos:altLabel "Uniform Resource Locator"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q42253>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#url> .

:c_49ebd1fc a skos:Concept;
  skos:definition "A barcode symbology used for tracking trade items in stores. Its most common form, the UPC-A, consists of 12 numerical digits."@en;
  skos:example "123456789999"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "UPC"@en;
  skos:altLabel "Universal Product Code"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1193047>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#upc> .

:c_b573f515 a skos:Concept;
  skos:definition "A unique and persistent identifier for software code artifacts commonly found in version control systems such as code files and commits available in the Software Heritage Archive. It consists of the mandatory identifier of the record in the Software Heritage archive and an optional list of qualifiers to provide information about the object’s context. "@en;
  skos:example "swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "SWHID"@en;
  skos:altLabel "SoftWare Hash Identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q134567344>;
  dct:modified "2026-06-13T01:10:03"^^xsd:dateTime;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#swhid> .

:c_96a8c2b8 a skos:Concept;
  skos:definition "A character string used to uniquely identify key inputs to an experiment including the so-called “key biological resources” as defined by the National Institutes of Health, and related tools such as core facilities and databases. An RRID name is divided into two parts, the authority and a local identifier, separated by an underscore."@en;
  skos:example "RRID:SCR_014641"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RRID"@en;
  skos:altLabel "Research Resource IDentifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q107278278>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#rrid> .

:c_b10276d1 a skos:Concept;
  skos:definition "A unique and persistent identifier for research projects. "@en;
  skos:example "https://raid.org/10.26259/5c43ca8f"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RAiD"@en;
  skos:altLabel "Research Activity Identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  dct:modified "2026-06-13T01:09:56"^^xsd:dateTime;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#raid> .

:c_ff6b1f44 a skos:Concept;
  skos:definition "A PURL has three parts: (1) a protocol, (2) a resolver address, and (3) a name."@en;
  skos:example "http://purl.oclc.org/foo/bar"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "PURL"@en;
  skos:altLabel "Persistent Uniform Resource Locator"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q195305>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#purl> .

:c_491eec33 a skos:Concept;
  skos:definition "A unique number assigned to each PubMed record."@en;
  skos:example "12082125"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "PMID"@en;
  skos:altLabel "PubMed identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q2082879>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#pmid> .

:c_19665f86 a skos:Concept;
  skos:definition "A unique identifier for data in the Life Science domain. Format: urn:lsid:authority:namespace:identifier:revision."@en;
  skos:example "urn:lsid:ubio.org:namebank:11815"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "LSID"@en;
  skos:altLabel "Life Science Identifiers"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q6459954>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#lsid> .

:c_036b6cbe a skos:Concept;
  skos:example "The linking ISSN or ISSN-L enables collocation or linking among different media versions of a continuing resource."@en,
    "1188-1534"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "LISSN"@en;
  skos:altLabel "Linking ISSN"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#lissn> .

:c_a61ff4a5 a skos:Concept;
  skos:definition "A unique “number” assigned to a textual work. An ISTC consists of 16 numbers and/or letters."@en;
  skos:example "0A9 2002 12B4A105 7"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ISTC"@en;
  skos:altLabel "International Standard Text Code"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1666944>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#istc> .

:c_23aeb12c a skos:Concept;
  skos:definition "A unique 8-digit number used to identify a print or electronic periodical publication."@en;
  skos:example "0077-5606"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ISSN"@en;
  skos:altLabel "International Standard Serial Number"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q131276>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#issn> .

:c_664844dc a skos:Concept;
  skos:definition "A unique numeric book identifier. There are 2 formats: a 10-digit ISBN format and a 13-digit ISBN."@en;
  skos:example "978-3-905673-82-1"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ISBN"@en;
  skos:altLabel "International Standard Book Number"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q33057>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#isbn> .

:c_bb41a882 a skos:Concept;
  skos:definition "A code that uniquely identifies samples from our natural environment and related features-of-interest."@en;
  skos:example "IECUR0097"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "IGSN"@en;
  skos:altLabel "International Generic Sample Number"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q17058352>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#igsn> .

:c_db36371f a skos:Concept;
  skos:definition "This refers specifically to an ID in the Handle system operated by the Corporation for National Research Initiatives (CNRI)."@en;
  skos:example "10013/epic.10033"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Handle"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:relatedMatch <https://www.wikidata.org/wiki/Q3126718>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#handle> .

:c_9cdedeb0 a skos:Concept;
  skos:definition "ISSN used to identify periodicals in electronic form (eISSN or e-ISSN)."@en;
  skos:example "1562-6865"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "EISSN"@en;
  skos:altLabel "Electronic International Standard Serial Number"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#eissn> .

:c_91caa317 a skos:Concept;
  skos:definition "A 13-digit barcoding standard that is a superset of the original 12-digit Universal Product Code (UPC) system."@en;
  skos:example "9783468111242"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "EAN13"@en;
  skos:altLabel "European Article Number"@en, "International Article Number"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en,
    "Now renamed International Article Number, but retaining the original acronym."@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q357404>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#ean13> .

:c_cc3c0083 a skos:Concept;
  skos:definition "A character string used to uniquely identify an object. A DOI name is divided into two parts, a prefix and a suffix, separated by a slash."@en;
  skos:example "10.1016/j.epsl.2011.11.037"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "DOI"@en;
  skos:altLabel "Digital Object Identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q25670>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#doi> .

:c_e3b9ba37 a skos:Concept;
  skos:definition "CSTR is an identifier based on the Chinese National Standard GB/T 32843—2016 “Science and technology resource identification”, providing a unique identification service for scientific data, papers, scientific institutions, researchers, scientific instruments, patents and other scientific and technological resources."@en;
  skos:example "31253.11.sciencedb.13238"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "CSTR"@en;
  skos:altLabel "Common Science and Technology Resources Identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q124257084>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#cstr> .

:c_58ef12c9 a skos:Concept;
  skos:definition "A standardized 19-character identifier according to the syntax yyyyjjjjjvvvvmppppa. See http://info-uri.info/registry/OAIHandler?verb=GetRecord&metadataPrefix=reg&identifier=info:bibcode/."@en;
  skos:example "2018AGUFM.A24K..07S"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "bibcode"@en;
  skos:altLabel "Astrophysics Data System bibliographic codes"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en,
    "bibcodes can be searched via https://ui.adsabs.harvard.edu/ or resolved using https://ui.adsabs.harvard.edu/abs/<bibcode>."@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q25754>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#bibcode> .

:c_14d152fa a skos:Concept;
  skos:definition "arXiv.org is a repository of preprints of scientific papers in the fields of mathematics, physics, astronomy, computer science, quantitative biology, statistics, and quantitative finance."@en;
  skos:example "arXiv:0706.0001"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ArXiv"@en;
  skos:altLabel "arXiv identifier"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  skos:exactMatch <https://www.wikidata.org/wiki/Q118398>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#arxiv> .

:c_9c7b1aa6 a skos:Concept;
  skos:definition "A URI designed to support long-term access to information objects. In general, ARK syntax is of the form (brackets, []. indicate optional elements): [http://NMA/]ark:/NAAN/Name [Qualifier]."@en;
  skos:example "ark:/13030/tqb3kh97gh8w"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ARK"@en;
  skos:altLabel "Archival Resource Key"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_c8cb9106;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#ark> .

:c_2c9da0f0 a skos:Concept;
  skos:definition "Describes a relationship between the source being regstered (A) and the related source (B)."@en;
  skos:scopeNote "Within TerraLID, the related source (B) is always the entity in TerraLID. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "relationType"@en;
  skos:note "This is a reproduction of the controlled list relationType in the DataCite Metadata version schema 4.7. The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000024>;
  dct:modified "2026-06-13T00:11:10"^^xsd:dateTime;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/> .

:c_42798d88 a skos:Concept;
  skos:definition "indicates A has a translation B"@en;
  skos:scopeNote "When a resource is shared in one language, then later translated to another, use “HasTranslation” to link the original resource to its translation. When a resource is released at the same time in multiple languages, use “HasTranslation” to connect the works to each other in both directions."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "HasTranslation"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_2c9da0f0;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#hastranslation> .

:c_3e9a7d5d a skos:Concept;
  skos:definition "indicates A is a translation of B"@en;
  skos:scopeNote "When a resource is shared in one language, then later translated to another, use “IsTranslationOf” to link the translation to the original."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "IsTranslationOf"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_2c9da0f0;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#istranslationof> .

:c_50f18eec a skos:Concept;
  skos:definition "indicates A collects B"@en;
  skos:scopeNote "May be used to indicate the relationship between an instrument and where it has been used to collect, measure, obtain, or observe data (as in, instrument A collects dataset B)."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Collects"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_2c9da0f0;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#collects> .

:c_7209d768 a skos:Concept;
  skos:definition "indicates A is collected by B"@en;
  skos:scopeNote "May be used to indicate the relationship between a dataset and an instrument that is used to collect, measure, obtain, or observe data (as in, dataset A is IsCollectedBy instrument B)."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "IsCollectedBy"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_2c9da0f0;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#iscollectedby> .

:c_b87ae52a a skos:Concept;
  skos:definition "indicates A is replaced by B"@en;
