  dct:modified "2026-06-13T00:09:01"^^xsd:dateTime .

:c_9c8f2a35 a skos:Concept;
  skos:definition "The object is a imitation of an other object that was produced when the original object was not in use or circulation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "modern imitation"@en;
  skos:broader :c_78d89252;
  skos:exactMatch <http://nomisma.org/id/modern_imitation> .

:c_1e12e502 a skos:Concept;
  skos:definition "The object is a contemporary imitation of an other object. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "contemporary imitation"@en;
  skos:broader :c_78d89252;
  skos:exactMatch <http://nomisma.org/id/contemporary_imitation> .

:c_149b5682 a skos:Concept;
  skos:definition "The object is authentic. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "genuine"@en;
  skos:altLabel "official"@en, "authentic"@en;
  skos:broader :c_78d89252;
  skos:exactMatch <http://nomisma.org/id/official> .

:c_dd76eaab a skos:Concept;
  skos:definition "The physical matter that was sampled for analysis. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample material"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000003>;
  skos:exactMatch <https://www.wikidata.org/wiki/Q24238356>;
  dct:modified "2026-06-13T00:11:31"^^xsd:dateTime .

:c_888076c5 a skos:Concept;
  skos:definition "Material that was created by geological processes. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "geological material"@en;
  skos:broader :c_dd76eaab .

:c_62b205ba a skos:Concept;
  skos:definition "Material that was created by humans. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "anthropogenic material"@en;
  skos:broader :c_dd76eaab;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material> .

:c_d5356583 a skos:Concept;
  skos:definition "Material that was transformed by the interaction of its pristine state with the (depositional) environment. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "alteration product"@en;
  skos:broader :c_dd76eaab;
  skos:closeMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product> .

:c_d339fac4 a skos:Concept;
  skos:definition "A fraction of the material that represents the average composition of the material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "bulk"@en;
  skos:broader :c_dd76eaab .

:c_dbeb733b a skos:Concept;
  skos:definition "Geological material from which resources are extracted, especially metals. "@en;
  skos:scopeNote "This entry refers specifically to the material classification in TerraLID for object-specific metadata. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ore (TerraLID category)"@en;
  skos:broader :c_9dd8c641 .

:c_b5560869 a skos:Concept;
  skos:definition "A crystalline component of the material with a fairly well-defined crystal structure and chemical composition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mineral"@en;
  skos:broader :c_888076c5;
  skos:exactMatch <https://vocabs.acdh.oeaw.ac.at/oeai-materials/concept23931>, <http://vocab.getty.edu/aat/300011068>,
    <https://www.wikidata.org/wiki/Q7946> .

:c_1e35bdea a skos:Concept;
  skos:definition "Anthropogenic material that is impacted by interaction processes with the (depositional) environment. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "alteration product (anthropogenic)"@en;
  skos:broader :c_62b205ba, :c_d5356583 .

:c_3a384c38 a skos:Concept;
  skos:definition "Anthropogenic material without any perceivable impact from interaction prosesses with the (depositional) environment."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "unaltered material"@en;
  skos:broader :c_888076c5, :c_62b205ba;
  skos:closeMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/not_altered> .

:c_f8762e3d a skos:Concept;
  skos:definition "The type of material obtained by sampling. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample type"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000017>;
  dct:modified "2026-06-13T00:11:40"^^xsd:dateTime .

:c_bfd0ca9e a skos:Concept;
  skos:definition "The sample was obtained with a rotary tool and is present in larger pieces. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "drill shavings"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://pid.geoscience.gov.au/def/voc/ga/sampletype/drill_chips_cuttings> .

:c_1a77d68d a skos:Concept;
  skos:definition "The analysis was carried out directly on the object without collecting a separate sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "in-situ"@en;
  skos:broader :c_f8762e3d;
  skos:exactMatch <http://vocab.getty.edu/aat/300220837>, <https://www.wikidata.org/wiki/Q216681> .

:c_153bc01e a skos:Concept;
  skos:definition "A powder was obtained during sampling or sampled material was subsequently ground to powder. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "powder"@en;
  skos:broader :c_f8762e3d;
  skos:exactMatch <http://pid.geoscience.gov.au/def/voc/ga/sampletype/powder>, <http://vocab.getty.edu/aat/300014647>,
    <https://www.wikidata.org/wiki/Q2908004> .

:c_26707627 a skos:Concept;
  skos:definition "A part of the object was crushed and the sample manually separated after visual inspection of each fragment. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "hand-picked"@en;
  skos:broader :c_f8762e3d .

:c_0118bbdc a skos:Concept;
  skos:definition "A part of the object was crushed and the sample extracted based on its physical or chemical properties (e.g., density, magnetic properties). "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mineral separate"@en;
  skos:broader :c_f8762e3d;
  skos:exactMatch <http://pid.geoscience.gov.au/def/voc/ga/sampletype/mineral_separate> .

:c_fb28d155 a skos:Concept;
  skos:definition "Acids or other solvents were applied to a usually crushed part of the object to extract the sample as solution. Usually only done with geological material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "leachate"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://vocab.getty.edu/aat/300053761> .

:c_07f899ac a skos:Concept;
  skos:definition "Acids or other solvents are applied with a soft and absorbent tool (e.g., Q-tip, sponge) on the object to extract the sample as solution absorbed to the same tool and/or particles adhering to it. Usually only carried out on archaeological materials. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "swabbed material"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://vocab.getty.edu/aat/300434176> .

:c_d8e9f67e a skos:Concept;
  skos:definition "The object was crushed in to pieces, which were then taken as sample. This is usually only done with larger items of geological origin such as rocks. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "hand specimen fragments"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://pid.geoscience.gov.au/def/voc/ga/sampletype/crush> .

:c_d57dc599 a skos:Concept;
  skos:definition "The object already had detached pieces, which were collected as sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "loose material"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://vocab.getty.edu/aat/300117130> .

:c_a7cdeda3 a skos:Concept;
  skos:definition "The sample is cut from the object with e.g. a blade or saw."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cut"@en;
  skos:broader :c_f8762e3d;
  skos:closeMatch <http://vocab.getty.edu/aat/300053069> .

:c_fb91df68 a skos:Concept;
  skos:definition "A larger piece of the object is cut with the aim to create a section of it, usually for inspection with a microscope and/or if the object is too large to fit into the analytical instrument's sample chamber. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "section"@en;
  skos:broader :c_f8762e3d;
  skos:exactMatch <http://vocab.getty.edu/aat/300379391> .

:c_d33a496b a skos:Concept;
  skos:definition "The section is polished to an even surface. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "polished section"@en;
  skos:broader :c_fb91df68;
  skos:relatedMatch <http://vocab.getty.edu/aat/300053867> .

:c_4365b275 a skos:Concept;
  skos:definition "The section is cut and polished to a thickness that it becomes translucent. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "thin section"@en;
  skos:broader :c_fb91df68;
  skos:exactMatch <http://pid.geoscience.gov.au/def/voc/ga/sampletype/polished_thin_section>,
    <http://vocab.getty.edu/aat/300386708>, <https://www.wikidata.org/wiki/Q542715> .

:c_2e6c0e69 a skos:Concept;
  skos:definition "The method used to extract a sample from an object. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sampling method"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000023>;
  skos:relatedMatch <http://vocab.getty.edu/aat/300379429>;
  dct:modified "2026-06-13T00:11:45"^^xsd:dateTime .

:c_961ffe7e a skos:Concept;
  skos:definition "The use of a rotating tool to remove material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "drilling"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <http://vocab.getty.edu/aat/300053151>, <https://www.wikidata.org/wiki/Q890886> .

:c_a5e29dda a skos:Concept;
  skos:definition "The use of a blade or saw to remove a chunk from the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cutting"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <http://vocab.getty.edu/aat/300053069>, <https://www.wikidata.org/wiki/Q196751> .

:c_3cc85343 a skos:Concept;
  skos:definition "The mechanical removal of material by applying material with a rough surface and higher hardness than the object."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "abrading"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <https://www.wikidata.org/wiki/Q3819233>;
  skos:closeMatch <http://vocab.getty.edu/aat/300053077> .

:c_89610abe a skos:Concept;
  skos:definition "The removal of material with a high energy beam such as a laser. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ablating"@en;
  skos:altLabel "laser ablation (sampling method)"@en;
  skos:broader :c_2e6c0e69;
  skos:closeMatch <http://vocab.getty.edu/aat/300379663>;
  dct:modified "2026-06-13T00:49:16"^^xsd:dateTime .

:c_959163ef a skos:Concept;
  skos:definition "The removal of material with an acid or solvent. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "dissolution"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <http://vocab.getty.edu/aat/300380018>, <https://www.wikidata.org/wiki/Q3133701> .

:c_64e8e4be a skos:Concept;
  skos:definition "The collection of material that was already detached from the object. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "fragment collection"@en;
  skos:broader :c_2e6c0e69;
  skos:closeMatch <http://vocab.getty.edu/aat/300077121> .

:c_9b8c9c7e a skos:Concept;
  skos:definition "The fragmentation of a material by applying mechanical force to it until it breals. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "crushing"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <http://vocab.getty.edu/aat/300053084>, <https://www.wikidata.org/wiki/Q2991605> .

:c_e06764b7 a skos:Concept;
  skos:definition "A rotary tool equipped with a camera that allows drilling on the micrometre scale in high spatial resolution. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "micromill"@en;
  skos:broader :c_961ffe7e .

:c_3eae3e76 a skos:Concept;
  skos:definition "The division of material into its components according to the components' properties. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "separation"@en;
  skos:broader :c_2e6c0e69;
  skos:exactMatch <http://vocab.getty.edu/aat/300053748>, <https://www.wikidata.org/wiki/Q898987> .

:c_852bd94d a skos:Concept;
  skos:definition "The separation process is based on the material components' magnetic properties. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "magnet separation"@en;
  skos:broader :c_3eae3e76;
  skos:relatedMatch <http://vocab.getty.edu/aat/300425051> .

:c_5eab7b34 a skos:Concept;
  skos:definition "The separation process is based on the material components' specific densities. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "density separation"@en;
  skos:broader :c_3eae3e76;
  skos:broadMatch <http://vocab.getty.edu/aat/300427901> .

:c_f3f96906 a skos:Concept;
  skos:definition "The separation of a specific component from crushed material by hand, usually according to its optical properties or shape. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "hand-picking"@en;
  skos:broader :c_3eae3e76 .

:c_15912994 a skos:Concept;
  skos:definition "The dissolution of material with the solvent or acid being applied with a spongy and/or absorbent tissue, usually on a small short stick. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "swabbing"@en;
  skos:altLabel "Q-tip"@en, "sponge"@en;
  skos:broader :c_959163ef;
  skos:closeMatch <http://vocab.getty.edu/aat/300434176> .

:c_02b29aae a skos:Concept;
  skos:definition "The dissolution of specific parts of a material by covering or submerging it in an acid or solvent. While etching only affects the surface, leaching affects the entire sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "etching/leaching"@en;
  skos:broader :c_959163ef;
  skos:exactMatch <http://vocab.getty.edu/aat/300053761>, <http://vocab.getty.edu/aat/300053840> .

:c_9313eed2 a skos:Concept;
  skos:definition "The state of the sample after analysis."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample state"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000019>;
  dct:modified "2026-06-13T00:11:36"^^xsd:dateTime .

:c_b1bf2e14 a skos:Concept;
  skos:definition "The sample was modified during analysis, e.g. by heating or partial dissolution. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "modified"@en;
  skos:broader :c_9313eed2 .

:c_19d31994 a skos:Concept;
  skos:definition "The sample was completely consumed by the analysis. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "no material left"@en;
  skos:broader :c_9313eed2 .

:c_27d9869d a skos:Concept;
  skos:definition "Part of the sample was consumed during analysis, e.g. by dissolving it. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "material consumed"@en;
  skos:broader :c_9313eed2 .

:c_b4ef9d51 a skos:Concept;
  skos:definition "The sample was not modified by the analysis."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "unchanged"@en;
  skos:broader :c_9313eed2 .

:c_d31174dd a skos:Concept;
  skos:definition "The aggregate state in which the sample is being analysed. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample introduction"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000023>;
  dct:modified "2026-06-13T00:11:27"^^xsd:dateTime .

:c_4301bc07 a skos:Concept;
  skos:definition "The sample was dissolved in liquids and the solution is analysed. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "solution"@en;
  skos:broader :c_d31174dd;
  skos:exactMatch <https://www.wikidata.org/wiki/Q5447188>, <http://vocab.getty.edu/aat/300210311> .

:c_95cd19d8 a skos:Concept;
  skos:definition "The sample was ablated with a laser and the ablated particles are analysed. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "laser ablation"@en;
  skos:broader :c_d31174dd;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1806547>;
  skos:closeMatch <http://vocab.getty.edu/aat/300379663> .

:c_c1c261a2 a skos:Concept;
  skos:definition "Procedures that operate on material samples to produce observation results with information about the physical properties, chemical or isotopic composition, crystallography, or molecular structure of the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "analytical method"@en;
  skos:note "Definition taken from: Richard, S. M., Klöcking, M., Luzi-Helbing, M., Johansson, A., Profeta, L., Lehnert, K., Elangovan, P., Sweets, H.A., Kallas, L., Sarbas, B., Mays, J., 2024. Analytical Methods for Geochemistry and Cosmochemistry. Concept Scheme for Analysis Methods in Geo- and Cosmochemistry. Published at Research Vocabularies Australia. Version 1.4.  https://vocabs.ardc.edu.au/viewById/650, published under a CC-BY license (version number of the license not provided). "@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000023>;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/analyticalmethod>,
    <https://www.wikidata.org/wiki/Q4751159>;
  dct:modified "2026-06-13T00:08:47"^^xsd:dateTime .

:c_c0d215f3 a skos:Concept;
  skos:definition "An analytical instrument in which the sample is ionised, the ions separated and detected according to their mass-to-charge ratio. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mass spectrometer"@en;
  skos:broader :c_c1c261a2;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/massspectrometry>,
    <https://www.wikidata.org/wiki/Q180809>, <https://vocab.getty.edu/aat/300225881> .

:c_e7d3223e a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is placed on a filament and ionised by heating the filament. With respect to lead isotope analyses, mass detection by a detector array in implied. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "TIMS"@en;
  skos:broader :c_c0d215f3;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/thermalionizationmassspectrometry> .

:c_32908a70 a skos:Concept;
  skos:definition "Mass spectrometry technique in which the sample is introduced into an inductively coupled plasma to atomize and ionize the sample for inlet to mass analyzer. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ICP-MS"@en;
  skos:note "Definition taken from Richard, S. M., Klöcking, M., Luzi-Helbing, M., Johansson, A., Profeta, L., Lehnert, K., Elangovan, P., Sweets, H.A., Kallas, L., Sarbas, B., Mays, J., 2024. Analytical Methods for Geochemistry and Cosmochemistry. Concept Scheme for Analysis Methods in Geo- and Cosmochemistry. Published at Research Vocabularies Australia. Version 1.4.  https://vocabs.ardc.edu.au/viewById/650, published under a CC-BY license (version number of the license not provided). "@en;
  skos:broader :c_c0d215f3;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/inductivelycoupledplasmamassspectrometry>,
    <https://www.wikidata.org/wiki/Q900680> .

:c_d0d46a2c a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ionised by an inductively coupled plasma and ions detected by an array of several detectors. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "MC-ICP-MS"@en;
  skos:broader :c_32908a70;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/multicollectorinductivelycoupledplasmamassspectrometry> .

:c_8e269b3e a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ionised by an inductively coupled plasma, iones separated by mass with a quadrupole and detected by single dectector. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Q-ICP-MS"@en;
  skos:broader :c_32908a70;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/quadrupoleinductivelycoupledplasmmassspectrometry> .

:c_6b7986e4 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam, introduced into an inductively coupled plasma to atomize and ionize the sample for inlet to mass analyzer. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "LA-ICP-MS"@en;
  skos:broader :c_32908a70;
  skos:exactMatch <https://w3id.org/geochem/1.0/analyticalmethod/laserablationinductivelycoupledplasmamassspectrometry>,
    <https://www.wikidata.org/wiki/Q108900669> .

:c_7b1b4216 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam, ionised by an inductively coupled plasma and ions detected by an array of several detectors. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "LA-MC-ICP-MS"@en;
  skos:broader :c_d0d46a2c, :c_6b7986e4 .

:c_0cd648d6 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam with laser pulses in the femtosecond range, introduced into an inductively coupled plasma to atomize and ionize the sample for inlet to mass analyzer. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "fs-LA-ICP-MS"@en;
  skos:broader :c_6b7986e4 .

:c_19f6f6d5 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam with laser pulses in the nanosecond range, introduced into an inductively coupled plasma to atomize and ionize the sample for inlet to mass analyzer. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ns-LA-ICP-MS"@en;
  skos:broader :c_6b7986e4 .

:c_e56f0531 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam with laser pulses in the femtosecond range, ionised by an inductively coupled plasma and ions detected by an array of several detectors. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "fs-LA-MC-ICP-MS"@en;
  skos:broader :c_7b1b4216 .

:c_e1700c12 a skos:Concept;
  skos:definition "Mass spectrometer in which the sample is ablated with a laser beam with laser pulses in the nanosecond range, ionised by an inductively coupled plasma and ions detected by an array of several detectors. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ns-LA-MC-ICP-MS"@en;
  skos:broader :c_7b1b4216 .

:c_5f1716a4 a skos:Concept;
  skos:definition "The mathematical model or procedure used to correct for the fractionation of an isotope ratio during measurement. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "mass bias correction"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000023>;
  dct:modified "2026-06-13T00:10:14"^^xsd:dateTime .

:c_39d3b302 a skos:Concept;
  skos:definition "A mathematical model assuming a linear relationship between the isotope ratio of the sample and a different isotope ratio of an internal standard added to the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "linear model"@en;
  skos:broader :c_5f1716a4;
  dct:references <https://doi.org/10.1016/j.gca.2003.11.024> .

:c_7b213d83 a skos:Concept;
  skos:definition "The correction of an isotope ratio's mass bias by altering the abundance of two other isotopes of the same element through the addition of an enriched isotopic spike"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "double-spike"@en;
  skos:broader :c_5f1716a4;
  dct:references <https://doi.org/10.1016/j.chemgeo.2009.05.010> .

:c_725495a8 a skos:Concept;
  skos:definition "The correction of an isotope ratio's mass bias in a sample by extrapolation from measurements of the same isotope ratio in an external standard measured before and after the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "standard-sample bracketing"@en;
  skos:broader :c_5f1716a4;
  dct:references <https://doi.org/10.1016/j.gca.2003.11.024> .

:c_17be86eb a skos:Concept;
  skos:definition "A mathematical model assuming a power-relationship between the isotope ratio of the sample and a different isotope ratio of an internal standard added to the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "power law"@en;
  skos:broader :c_5f1716a4;
  dct:references <https://doi.org/10.1016/j.gca.2003.11.024> .

:c_e9b3f7f1 a skos:Concept;
  skos:definition "A mathematical model assuming an exponential relationship between the isotope ratio of the sample and a different isotope ratio of an internal standard added to the sample. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "exponential law"@en;
  skos:altLabel "Russell model"@en;
  skos:broader :c_5f1716a4;
  dct:references <https://doi.org/10.1016/j.gca.2003.11.024> .

:c_c7d45a2d a skos:Concept;
  skos:definition "A reference material (RM) is a material that is sufficiently stable and homogeneous in one or more of its properties and whose use for the calibration of measurements has been established. A certified reference material (CRM) is characterised by metrologically valid procedures for one or more specified properties and is accompanied by a certificate for this characterisation. Standard reference material\" (SRM) is a trademarked term for CRMs satisfying additional criteria specified by the United States National Institute of Standards and Technology (NIST). "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "reference material"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000003>;
  skos:closeMatch <https://www.wikidata.org/wiki/Q906323>;
  dct:modified "2026-06-13T00:11:00"^^xsd:dateTime .

