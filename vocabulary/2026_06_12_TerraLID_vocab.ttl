:c_8441accd a skos:Concept;
  skos:definition "The relationship between the mineral and the matrix and other minerals, conveying information about the mineral's formation conditions. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "mineral texture"@en;
  skos:note "The terms are mostly taken from U. Neumann (2020), Guide for the microscopical identification of ore and gangue minerals, Tübingen University Press (http://dx.doi.org/10.15496/publikation-38866). However, the definitions are original and based on various sources because the relevant literature, including the aforementioned publication, do not explicitly defines textures but provide examples for them in photomicrographs. "@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000019>;
  dct:modified "2026-06-13T00:10:19"^^xsd:dateTime .

:c_e74b28a0 a skos:Concept;
  skos:definition "The state of interlocking of different mineral grains due to simultaneous crystallisation."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "intergrowth"@en;
  skos:broader :c_8441accd .

:c_dd1113d4 a skos:Concept;
  skos:definition "Large and often lath-shaped euhedral or subhedral crystals are partly or fully included in much larger crystals."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ophitic"@en;
  skos:broader :c_e74b28a0 .

:c_cab80d83 a skos:Concept;
  skos:definition "Filling of interstitial space with a glass or a vitreous phase with small crystals. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "intersertal"@en;
  skos:broader :c_e74b28a0 .

:c_1a4f781a a skos:Concept;
  skos:definition "The mineral grew in the interstitial space between grains or structures.  "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "interstitial"@en;
  skos:broader :c_e74b28a0 .

:c_3e50acb7 a skos:Concept;
  skos:definition "Intimate intergrowth of randomly orientated mineral grains with no gaps or cement between them."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "interlocked"@en;
  skos:broader :c_e74b28a0 .

:c_9e0d2c4a a skos:Concept;
  skos:definition "The fine-grained vermicular (\"worm-shaped\") intergrowth of two minerals, often indicating the breakdown of unstable phases. "@en;
  skos:scopeNote "Myrmekitic as specific case of symplectitic texture. Appears to be often used synonymously at least in ore microscopy . "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "symplectitic"@en;
  skos:altLabel "vermicular"@en;
  skos:broader :c_e74b28a0 .

:c_5eaf970c a skos:Concept;
  skos:definition "A symplectitic intergrowth of plagioclase and vermicular quartz."@en;
  skos:scopeNote "Myrmekitic as specific case of symplectitic texture. Appears to be often used synonymously at least in ore microscopy . "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "myrmekitic"@en;
  skos:broader :c_9e0d2c4a .

:c_6655861f a skos:Concept;
  skos:definition "Small grains of one mineral are randomly scattered without common orientation in larger grains of another mineral."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "poikiloblastic"@en;
  skos:altLabel "poikilitic"@en, "sieve texture"@en;
  skos:broader :c_e74b28a0 .

:c_aa5d33c3 a skos:Concept;
  skos:definition "The mineral is scattered as small grains throughout another mineral or the matrix. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "disseminated"@en;
  skos:broader :c_e74b28a0 .

:c_436d944e a skos:Concept;
  skos:definition "A mineral grew in the rim of another mineral. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "rimmed"@en;
  skos:broader :c_e74b28a0 .

:c_e5b6f80a a skos:Concept;
  skos:definition "A mineral with irregular outlines and anhedral crystals. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "amoeboid"@en;
  skos:broader :c_e74b28a0 .

:c_04619e43 a skos:Concept;
  skos:definition "Growth of minerals in small roughly regular-shaped rounded aggregates that resemble the shape of biological cells. Or the porous texture of a rock characterised by abundant openings or cavities, which may or may not be connected.  "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cellular (intergrowth)"@en;
  skos:altLabel "porous"@en, "cavernous"@en, "vesicular"@en;
  skos:broader :c_e74b28a0 .

:c_95b262b5 a skos:Concept;
  skos:definition "The growth of a ring-shaped mineral around and surrounded by other minerals. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "atoll-like"@en;
  skos:altLabel "core texture"@en;
  skos:broader :c_e74b28a0 .

:c_a3d375e7 a skos:Concept;
  skos:definition "The growth of a new or chemically different mineral as a reaction product of the already existing mineral. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "replacement"@en;
  skos:broader :c_8441accd .

:c_f478f111 a skos:Concept;
  skos:definition "An intergrowth of  different minerals in which the larger crystals have a fairly regular geometric outline and orientation, and resemble cuneiform writing or have a thread-like appearance.  "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "filiform"@en;
  skos:altLabel "graphic texture"@en;
  skos:broader :c_a3d375e7 .

:c_52eaf264 a skos:Concept;
  skos:definition "The growth of elongated rounded aggregates of secondary minerals inside the primary mineral, often as a result of alteration of the primary mineral. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "graphic"@en;
  skos:broader :c_a3d375e7 .

:c_8c47dce3 a skos:Concept;
  skos:definition "The growth of minerals replacing the content of cells in originally biological matter such as plants in coal. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cellular (replacement)"@en;
  skos:broader :c_a3d375e7 .

:c_7b190793 a skos:Concept;
  skos:definition "The original mineral reacted from the outside, leaving an (island-shaped) unreacted part surrounded by secondary minerals. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "island-shaped"@en;
  skos:broader :c_a3d375e7 .

:c_d78ab7be a skos:Concept;
  skos:definition "Growth of secondary minerals in cavities and along fracture or cleavage planes from which previously present minerals were removed by e.g. dissolution, creating a network texture resembling stacked boxes or honey-combs. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "boxwork"@en;
  skos:broader :c_a3d375e7 .

:c_36ca06ef a skos:Concept;
  skos:definition "Relict of a skeletal crystal of one mineral enclosed in another mineral species.   "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "skeleton-shaped"@en;
  skos:broader :c_a3d375e7 .

:c_d3b9f898 a skos:Concept;
  skos:definition "The growth of a secondary mineral from the grain boundary into the primary minerals, resulting in a grain boundary between both minerals with many scallop-shaped, concave embayments. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cusp-and-caries"@en;
  skos:broader :c_a3d375e7 .

:c_bb44a01a a skos:Concept;
  skos:definition "The dissolution of small areas of a mineral, often at its rim, resulting in voids. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "lacuna"@en;
  skos:broader :c_a3d375e7 .

:c_7fe5c1ff a skos:Concept;
  skos:definition "The oriented growth of a secondary mineral in elongated shapes within the primary mineral, usually along cleavage planes, crystal planes, twin boundaries or fractures. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "lamellar"@en;
  skos:broader :c_a3d375e7 .

:c_7d8b3c14 a skos:Concept;
  skos:definition "The evenly-spaced growth of a secondary mineral along the crystallographic orientation of the primary mineral's grain boundary. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "zonal"@en;
  skos:broader :c_a3d375e7 .

:c_dd91efb2 a skos:Concept;
  skos:definition "The replacement of one mineral by another with leaving the outermost original mineral unaffected, and constituting the \"atoll\". "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "atoll-like (replacement)"@en;
  skos:broader :c_a3d375e7 .

:c_d375a5c9 a skos:Concept;
  skos:definition "The growth of a dense anhedral alteration mineral in the matrix. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cement-shaped"@en;
  skos:broader :c_a3d375e7 .

:c_0571a899 a skos:Concept;
  skos:definition "A secondary mineral completely replacing the primary mineral while retaining the shape of the primary mineral's grains. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "pseudomorph"@en;
  skos:broader :c_a3d375e7;
