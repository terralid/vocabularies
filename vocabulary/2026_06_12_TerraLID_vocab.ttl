  skos:exactMatch <http://vocab.getty.edu/aat/300014720>, <https://www.wikidata.org/wiki/Q863583> .

:c_4e57487f a skos:Concept;
  skos:definition "The colour-giving constituent of a pigment or glass."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "colorant"@en;
  skos:hiddenLabel "colourant"@en;
  skos:broader :c_e96ca20e, :c_924da16f;
  skos:exactMatch <https://www.wikidata.org/wiki/Q911922>, <http://vocab.getty.edu/aat/300013026> .

:c_c5cb1257 a skos:Concept;
  skos:definition "Material added to another material to lower its melting point. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "flux"@en;
  skos:broader :c_924da16f;
  skos:exactMatch <http://vocab.getty.edu/aat/300015137>, <https://www.wikidata.org/wiki/Q1134475> .

:c_8469dc11 a skos:Concept;
  skos:definition "The process of changing a material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "alteration process"@en;
  skos:closeMatch <http://vocab.getty.edu/aat/300105442>;
  dct:modified "2026-06-13T00:08:37"^^xsd:dateTime .

:c_f87cfd32 a skos:Concept;
  skos:definition "The alteration of materials by light. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "photodegradation"@en;
  skos:broader :c_8469dc11;
  skos:exactMatch <http://vocab.getty.edu/aat/300379409>, <https://www.wikidata.org/wiki/Q1902073> .

:c_ee0c9aa1 a skos:Concept;
  skos:definition "The reaction of the material with oxygen. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "oxidation"@en;
  skos:broader :c_8469dc11;
  skos:exactMatch <http://vocab.getty.edu/aat/300220235>, <https://www.wikidata.org/wiki/Q1786087> .

:c_dab8858f a skos:Concept;
  skos:definition "The loss of material through surface processes and its deposition elsewhere. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "erosion"@en;
  skos:broader :c_8469dc11;
  skos:exactMatch <http://vocab.getty.edu/aat/300054116> .

:c_226caccd a skos:Concept;
  skos:definition "The breakdown of usually organic matter by microorganisms. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "biodegradation"@en;
  skos:broader :c_8469dc11;
  skos:exactMatch <http://vocab.getty.edu/aat/300419379>, <https://www.wikidata.org/wiki/Q696715> .

:c_3ad03b3e a skos:Concept;
  skos:definition "The loss of the materials brightness and depth. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "darkening"@en;
  skos:broader :c_8469dc11;
  skos:exactMatch <http://vocab.getty.edu/aat/300379491> .

:c_8855f5a4 a skos:Concept;
  skos:definition "The migration of salt to the surface of a (porous) material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "efflorescense"@en;
  skos:broader :c_8469dc11 .

:c_49d4f3c8 a skos:Concept;
  skos:definition "Definition of a geometrical space or nomenclature that represents colours. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "colour system"@en;
  skos:exactMatch <http://vocab.getty.edu/aat/300311091>, <https://www.wikidata.org/wiki/Q1396457>;
  dct:modified "2026-06-13T00:09:06"^^xsd:dateTime .

:c_63dd4d16 a skos:Concept;
  skos:definition "The colour as perceived by a person. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "eye"@en;
  skos:broader :c_49d4f3c8;
  skos:exactMatch <https://www.wikidata.org/wiki/Q7364> .

:c_ffd62f45 a skos:Concept;
  skos:definition "A colour system developed by A. H. Munsell in the early 20th century. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Munsell"@en;
  skos:broader :c_49d4f3c8;
  skos:exactMatch <https://www.wikidata.org/wiki/Q768549>, <http://vocab.getty.edu/aat/300311089> .

:c_4f63611c a skos:Concept;
  skos:definition "A colour system defined by the International Commission on Illumination, expressing colour in a three-dimensional space with lightness (L*), red-green (A*), and blue-yellow (b*) as axes. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "CIELAB"@en;
  skos:altLabel "L*a*b*"@en;
  skos:broader :c_49d4f3c8;
  skos:exactMatch <https://www.wikidata.org/wiki/Q375414> .

:c_e4ed600b a skos:Concept;
  skos:definition "The type of contributor of the resource. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "contributorType"@en;
  skos:note "This is a reproduction of the controlled list contributorType in the DataCite Metadata version schema 4.7. The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license."@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/0000074>;
  dct:modified "2026-06-13T00:09:24"^^xsd:dateTime;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/> .

:c_3a208ae6 a skos:Concept;
  skos:definition "Any person or institution making a significant contribution to the development and/or maintenance of the resource, but whose contribution is not adequately described by any of the other values for contributorType."@en;
  skos:scopeNote "Could be a photographer, artist, or writer whose contribution helped to publicize the resource (as opposed to creating it), a reviewer of the resource, someone providing administrative services to the author (such as depositing updates into an online repository, analysing usage, etc.), or one of many other roles."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Other (contributorType)"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#other> .

:c_50da8fc6 a skos:Concept;
  skos:definition "A Work Package is a recognized data product, not all of which is included in publication. The package, instead, may include notes, discarded documents, etc. The Work Package Leader is responsible for ensuring the comprehensive contents, versioning, and availability of the Work Package during the development of the resource."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "WorkPackageLeader"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#workpackageleader> .

:c_79574dab a skos:Concept;
  skos:definition "A person, organization, or automated system responsible for converting the content of a resource from one language into another, preserving its meaning and intended message."@en;
  skos:scopeNote "This contributor type should be applied to DOI metadata for a resource which has been translated from another resource."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Translator"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  skos:exactMatch <https://www.wikidata.org/wiki/Q333634>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#translator> .

:c_2f9a64df a skos:Concept;
  skos:definition "Designated administrator over one or more groups/teams working to produce a resource, or over one or more steps of a development process."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Supervisor"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#supervisor> .

:c_8ff2aeb0 a skos:Concept;
  skos:definition "Person or organisation that issued a contract or under the auspices of which a work has been written, printed, published, developed, etc."@en;
  skos:scopeNote "Includes organisations that provide in-kind support, through donation, provision of people or a facility or instrumentation necessary for the development of the resource, etc."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Sponsor"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#sponsor> .

:c_f18d65a2 a skos:Concept;
  skos:definition "Person or institution owning or managing property rights, including intellectual property rights over the resource."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RightsHolder"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#rightsholder> .

:c_57b3dd9a a skos:Concept;
  skos:definition "Typically refers to a group of individuals with a lab, department, or division that has a specifically defined focus of activity."@en;
  skos:scopeNote "May operate at a narrower level of scope; may or may not hold less administrative responsibility than a project team."@en;
  skos:example "Space Research & Planetary Sciences Division of the University of Bern (WP Unibe)"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ResearchGroup"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1241025>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#researchgroup> .

:c_e1f2cf05 a skos:Concept;
  skos:definition "A person involved in analysing data or the results of an experiment or formal study. May indicate an intern or assistant to one of the authors who helped with research but who was not so “key” as to be listed as an author."@en;
  skos:scopeNote "Should be a person, not an institution. Note that a person involved in the gathering of data would fall under the contributorType “DataCollector.” The researcher may find additional data online and correlate it to the data collected for the experiment or study, for example."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Researcher"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1650915>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#researcher> .

:c_ad00bdad a skos:Concept;
  skos:definition "A person without a specifically defined role in the development of the resource, but who is someone the author wishes to recognize."@en;
  skos:scopeNote "This person could be an author’s intellectual mentor, a person providing intellectual leadership in the discipline or subject domain, etc."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RelatedPerson"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#relatedperson> .

:c_ebc3e072 a skos:Concept;
  skos:definition "A standards-setting body from which Registration Agencies obtain official recognition and guidance."@en;
  skos:scopeNote "The IDF serves as the Registration Authority for the International Standards Organisation (ISO) in the area/domain of Digital Object Identifiers."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RegistrationAuthority"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#registrationauthority> .

:c_c8f80f6c a skos:Concept;
  skos:definition "Institution/organisation officially appointed by a Registration Authority to handle specific tasks within a defined area of responsibility."@en;
  skos:scopeNote "DataCite is a Registration Agency for the International DOI Foundation (IDF). One of DataCite’s tasks is to assign DOI prefixes to the allocating agents who then assign the full, specific character string to data clients, provide metadata back to the DataCite registry, etc."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "RegistrationAgency"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#registrationagency> .

:c_c6bb8064 a skos:Concept;
  skos:definition "Person on the membership list of a designated project/project team."@en;
  skos:scopeNote "This vocabulary may or may not indicate the quality, quantity, or substance of the person’s involvement."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ProjectMember"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectmember> .

:c_384d11d1 a skos:Concept;
  skos:definition "Person officially designated as manager of a project. Project may consist of one or many project teams and sub-teams."@en;
  skos:scopeNote "The manager of a project normally has more administrative responsibility than actual work involvement."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ProjectManager"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  skos:exactMatch <https://www.wikidata.org/wiki/Q816432>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectmanager> .

:c_dd32fd29 a skos:Concept;
  skos:definition "Person officially designated as head of project team or sub- project team instrumental in the work necessary to development of the resource."@en;
  skos:scopeNote "The Project Leader is not “removed” from the work that resulted in the resource; he or she remains intimately involved throughout the life of the particular project team."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ProjectLeader"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectleader> .

:c_7250b71d a skos:Concept;
  skos:definition "Typically, a person or organisation responsible for the artistry and form of a media product."@en;
  skos:scopeNote "In the data industry, this may be a company “producing” DVDs that package data for future dissemination by a distributor."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Producer"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#producer> .

:c_041e374c a skos:Concept;
  skos:definition "Typically, the organisation allowing the resource to be available on the internet through the provision of its hardware/software/operating support."@en;
  skos:scopeNote "This role normally falls on the University, research center or organization where the data center/data repository belongs."@en;
  skos:example "Université Grenoble Alpes (UGA)"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "HostingInstitution"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#hostinginstitution> .

:c_36d34fdb a skos:Concept;
  skos:definition "A person who oversees the details related to the publication format of the resource."@en;
  skos:scopeNote "If the Editor is to be credited in place of multiple creators, the Editor’s name may be supplied as Creator, with “(Ed.)” appended to the name."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Editor"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#editor> .

:c_62875695 a skos:Concept;
  skos:definition "Institution tasked with responsibility to generate/disseminate copies of the resource in either electronic or print form."@en;
  skos:scopeNote "Works stored in more than one archive/repository may credit each as a distributor."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Distributor"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#distributor> .

:c_8034b473 a skos:Concept;
  skos:definition "Person (or organisation with a staff of data managers, such as a data centre) responsible for maintaining the finished resource."@en;
  skos:scopeNote "The work done by this person or organisation ensures that the resource is periodically “refreshed” in terms of software/hardware support, is kept available or is protected from unauthorized access, is stored in accordance with industry standards, and is handled in accordance with the records management requirements applicable to it."@en;
  skos:example "https://doi.org/10.6073/pasta/41b3ed2e152e1e4c3846e646118208e7"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "DataManager"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datamanager> .

:c_eed9b69e a skos:Concept;
  skos:definition "Person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a data centre or repository."@en;
  skos:scopeNote "While the DataManager is concerned with digital maintenance, the DataCurator’s role encompasses quality assurance focused on content and metadata. DataCurator responsibilities include: checking completeness of the submitted dataset against the content as described by the submitter; verifying standard metadata according to the applicable system or schema; adding or verifying specialized metadata to add value and ensure access across disciplines; and determining how the metadata might map to search engines, database products, and automated feeds. Repository managers as well as data librarians working in the repository fall within this category."@en;
  skos:example "https://doi.org/10.20375/0000-000D-1D1F-2"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "DataCurator"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datacurator> .

:c_f5974a2b a skos:Concept;
  skos:definition "Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI)."@en;
  skos:scopeNote "May also be used when crediting survey conductors, interviewers, event or condition observers, or persons responsible for monitoring key instrument data."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "DataCollector"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datacollector> .

:c_34e78a4f a skos:Concept;
  skos:definition "Person with knowledge of how to access, troubleshoot, or otherwise field issues related to the resource."@en;
  skos:scopeNote "May also be the “Point of Contact” in an organisation that controls access to the resource, if that organisation is different from the Publisher, Distributor, and Data Manager."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ContactPerson"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_e4ed600b;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#contactperson> .

:c_6de9e3f7 a skos:Concept;
  skos:definition "General information about whether objects or materials are available for investigation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample access"@en;
  dct:modified "2026-06-13T00:11:19"^^xsd:dateTime .

:c_06c40941 a skos:Concept;
  skos:definition "The object or material is generally accessible for investigation."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "accessible"@en;
  skos:broader :c_6de9e3f7 .

:c_b1cf95c1 a skos:Concept;
  skos:definition "The institution holding the object or material has a policy regulating access to objects and materials for investigation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "policy"@en;
  skos:broader :c_6de9e3f7 .

:c_fba4dbc9 a skos:Concept;
  skos:definition "The object or material is not accessible for investigation or analysis in general. "@en;
  skos:inScheme :conceptScheme_a0559f69;
