:c_84c6c6e0 a skos:Concept;
  skos:definition "The incidental discovery (and recovery) of materials of interest. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "stray find"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/146344> .

:c_eb09b8cd a skos:Concept;
  skos:definition "Drilling into the ground with the aim to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "borehole survey"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145112> .

:c_410a0d02 a skos:Concept;
  skos:definition "Drilling into the ground with the aim to retrieve the content of the borehole as a whole. The material will subsequently be used to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "core drilling"@en;
  skos:broader :c_eb09b8cd;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/core-drilling>,
    <http://inspire.ec.europa.eu/codelist/ExplorationActivityTypeValue/coreDrilling> .

:c_19639bab a skos:Concept;
  skos:definition "Drilling into the ground with the aim to retrieve the content of the borehole as loose material to retrieve samples. In some cases, it can be used to infer stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "auger drilling"@en;
  skos:broader :c_eb09b8cd;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/auger-drilling>,
    <http://purl.org/heritagedata/schemes/agl_et/concepts/145111> .

:c_3f471934 a skos:Concept;
  skos:definition "The use of a metal detector to discover artefacts. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "metal detecting"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <https://www.wikidata.org/wiki/Q111047657>;
  skos:closeMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145147>, <http://purl.org/heritagedata/schemes/agl_et/concepts/145148> .

:c_cd2a7865 a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an site and to retrieve samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "excavation"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145129>, <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/excavation>,
    <http://vocab.getty.edu/aat/300266151>;
  skos:closeMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145160> .

:c_8eff20cd a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to answer a specific research question by recording an site and retrieving samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "research excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/147305> .

:c_f39b79f2 a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an site under threat of destruction and to retrieve samples and artefacts from the site under strict time constraints. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "rescue excavation"@en;
  skos:altLabel "salvage excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145157>, <https://www.wikidata.org/wiki/Q101008619> .

:c_6a6e0a7f a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an underwater site and to retrieve samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "underwater excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/163244> .

:c_ae4a0583 a skos:Concept;
  skos:definition "Non-intrusive fieldwork to document the extent and layout of a site through recording the position and distribution of specimens and artefacts."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "survey"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/170654> .

:c_2758f3b1 a skos:Concept;
  skos:definition "The economic extraction of georesources from the earth. This includes surface and underground operations. "@en;
  skos:inScheme :conceptScheme_a0559f69;
