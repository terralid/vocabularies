:c_ca223f0b a skos:Concept;
  skos:definition "Information about whether an (archaeological) context includes material from a single depositional event and whether the context is impacted by any post-depositional processes. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "context type"@en;
  skos:broadMatch <https://vocabs.dariah.eu/bbt/Concept/000024>;
  dct:modified "2026-06-13T00:09:19"^^xsd:dateTime .

:c_0541320f a skos:Concept;
  skos:definition "The context represents a single depositional event with all material coming from the same source and no interaction happening after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "undisturbed context"@en;
  skos:altLabel "primary context"@en;
  skos:broader :c_ca223f0b;
  skos:closeMatch <https://www.wikidata.org/wiki/Q136826284> .

:c_0faa6b29 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "disturbed context"@en;
  skos:altLabel "secondary context"@en;
  skos:broader :c_ca223f0b;
  skos:closeMatch <https://www.wikidata.org/wiki/Q136826785> .

:c_9408f513 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with humans being the responsible agents. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "anthropogenically disturbed"@en;
  skos:broader :c_0faa6b29 .

:c_1c4bfb96 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with non-humans being the responsible agents (e.g. bioturbidation)."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "biogenically disturbed"@en;
  skos:broader :c_0faa6b29 .

:c_a0ae7ce8 a skos:Concept;
  skos:definition "The context represents a single depositional event with material coming from multiple sources and no interaction happening after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mixed context"@en;
  skos:broader :c_ca223f0b .

