:c_f0e6044b a skos:Concept;
  skos:definition "Determination of the age by determining the extent to which the secular equilibrium between 230Th and 234U was restored in a material that was nominally thorium-free at the point of its creation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "uranium-series dating"@en;
  skos:altLabel "U-series dating"@en;
