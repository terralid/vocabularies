<rdf:Description rdf:about="http://vocab.terralid.org#c_068f3adc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is (predominantly) made of a metallic material. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">metal</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9dd8c641"/>
