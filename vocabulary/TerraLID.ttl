	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q13431773"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9c8f2a35">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is a imitation of an other object that was produced when the original object was not in use or circulation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">modern imitation</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_78d89252"/>
	<skos:exactMatch rdf:resource="http://nomisma.org/id/modern_imitation"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1e12e502">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is a contemporary imitation of an other object. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">contemporary imitation</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_78d89252"/>
	<skos:exactMatch rdf:resource="http://nomisma.org/id/contemporary_imitation"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_149b5682">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is authentic. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">genuine</skos:prefLabel>
	<skos:altLabel xml:lang="en">official</skos:altLabel>
	<skos:altLabel xml:lang="en">authentic</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_78d89252"/>
	<skos:exactMatch rdf:resource="http://nomisma.org/id/official"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_dd76eaab">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The physical matter that was sampled for analysis. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">sample material</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q24238356"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_888076c5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Material that was created by geological processes. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">geological material</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_dd76eaab"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_62b205ba">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Material that was created by humans. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">anthropogenic material</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_dd76eaab"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d5356583">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Material that was transformed by the interaction of its pristine state with the (depositional) environment. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration product</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_dd76eaab"/>
	<skos:closeMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d339fac4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A fraction of the material that represents the average composition of the material. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">bulk</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_dd76eaab"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_dbeb733b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Geological material from which resources are extracted, especially metals. </skos:definition>
	<skos:scopeNote xml:lang="en">This entry refers specifically to the material classification in TerraLID for object-specific metadata. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ore (TerraLID category)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9dd8c641"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b5560869">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A crystalline component of the material with a fairly well-defined crystal structure and chemical composition. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mineral</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:exactMatch rdf:resource="https://vocabs.acdh.oeaw.ac.at/oeai-materials/concept23931"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300011068"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q7946"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1e35bdea">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Anthropogenic material that is impacted by interaction processes with the (depositional) environment. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration product (anthropogenic)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_62b205ba"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_d5356583"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3a384c38">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Anthropogenic material without any perceivable impact from interaction prosesses with the (depositional) environment.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">unaltered material</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_62b205ba"/>
	<skos:closeMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/not_altered"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f8762e3d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The type of material obtained by sampling. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">sample type</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000017"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_bfd0ca9e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
