<rdf:Description rdf:about="http://vocab.terralid.org#c_d7fb0caf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is (predominantly) made of a nonmetallic malleable material that was intentionally transformed at high temperatures into a non-malleable state. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ceramic</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9dd8c641"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_62b205ba"/>
