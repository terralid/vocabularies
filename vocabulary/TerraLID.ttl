<rdf:Description rdf:about="http://vocab.terralid.org#c_27e6e534">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The part of the ore that is affected by natural post-genetic processes, often including interaction with a hydrous fluid.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4dffb82b"/>
	<skos:broadMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/alteration"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_39a52896">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The economically viable part of the ore. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ore mineral</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4dffb82b"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/raw-material-role/ore"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1969263"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6e9f3cf6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An economically viable mineral dominating the ore's mineralogical composition.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">major mineral</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_39a52896"/>
	<skos:related rdf:resource="http://resource.geosciml.org/classifier/cgi/proportionterm/dominant"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_42b68c9f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An economically viable mineral constituting a minor part in the ore's mineralogy. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">minor mineral</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_39a52896"/>
	<skos:related rdf:resource="http://resource.geosciml.org/classifier/cgi/proportionterm/minor"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_235c43fb">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The part of an ore not deemed economically desirable. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">gangue</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/gangue"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1061670"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2490c7e3">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Specialized devices used to determine the chemical or physical properties of substances, especially their composition, qunatity, or structure.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">analytical instrument</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q112270652"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4c5dbb51">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">MC-ICP-MS (instrument)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e3df0ac6"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_75732fae">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">TIMS (instrument)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e3df0ac6"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_60b698fb">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A qualitative classification for the quantity of a compund based on its concentration. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">abundance (concentration)</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0e342dcb">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Compound with a concentration of more than 0.4 wt%. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">major</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_60b698fb"/>
	<dct:references rdf:resource="https://doi.org/10.1007/978-3-319-39193-9_255-1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e954a190">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Compound with a concentration between 0.4 and 0.1 wt%. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">minor</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_60b698fb"/>
	<dct:references rdf:resource="https://doi.org/10.1007/978-3-319-39193-9_255-1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_29d78b2d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Compound with a concentration of less than 0.1 wt%. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">trace</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_60b698fb"/>
	<dct:references rdf:resource="https://doi.org/10.1007/978-3-319-39193-9_255-1"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4e14cebd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The degree of the material's alteration. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration extent</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a9cb8f24">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material is altered to an extent that it is very difficult or impossible to retrieve pristine material for analysis. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">severe alteration</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4e14cebd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e935826d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material is altered but includes enough pristine material for analyses. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">slight alteration</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4e14cebd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_eb1223d0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material does not show any indication of alteration. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">no alteration</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4e14cebd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f5cb57a0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Classification for the type of raw materials used in the production of the object. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">production context</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_80dcdedf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material was not altered after its initial production from raw materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">primary</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_f5cb57a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d179db0a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material was not directly derived from its raw materials but represent the re-use (mixing, recycling) of materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">secondary</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_f5cb57a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e4626b4d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Classification to indicate whether an object shows signs of being a recycling product. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">recycling indicator</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_08e80a7e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Indications for a conversion of one or several materials into the object exist but do not warrant a confirmation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">recycling suspected</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e4626b4d"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3a6292d6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material is not the result of re-using other materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">not recycled</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e4626b4d"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d1e3b55d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">One or several materials were converted into the object. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">recycled</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e4626b4d"/>
	<skos:closeMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/end-use-potential/recycling"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3ba0ff02">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The degree to which a material is affected by corrosion. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">corrosion extent</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_372633f8">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material consists mostly of corrosion products and it requires close observation to find uncorroded material. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">severe corrosion</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_3ba0ff02"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1dba855c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Corrosion products are widely present but uncorroded material can still be readily found. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">moderate corrosion</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_3ba0ff02"/>
</rdf:Description>

