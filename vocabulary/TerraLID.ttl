<rdf:Description rdf:about="http://vocab.terralid.org#c_9775890c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A usually small, flat and round piece of metal primarily used as medium of exchange or legal tender. It usually follows a standardised system in weight and sometimes size and is produced in large quantities. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">coin</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000017"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_068f3adc"/>
	<skos:exactMatch rdf:resource="http://nomisma.org/id/coin"/>
	<skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q41207"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300037222"/>
	<skos:exactMatch rdf:resource="http://d-nb.info/gnd/4040629-5"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_78d89252">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Whether the object is a genuine representation or an imitation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
