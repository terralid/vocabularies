<rdf:Description rdf:about="http://vocab.terralid.org#c_5f810e19">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Area collecting discarded material from ore beneficiation activities is collected. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">tailing dump</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0e020c21"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9bf30dd9"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300000832"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1784525"/>
