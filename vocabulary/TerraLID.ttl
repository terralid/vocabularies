<rdf:Description rdf:about="http://vocab.terralid.org#c_5a103a06">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The component of the glass regulating the length of the chains build by the network former. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">network modifier</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e96ca20e"/>
