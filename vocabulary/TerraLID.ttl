</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5264a37a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Atom that is characterised by its number of protons and number of neutrons. </skos:definition>
	<skos:scopeNote xml:lang="en">Only naturally occurring nuclides were included. While it was aimed to include all stable nuclides, only some radioactive nuclides are included. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">nuclide</skos:prefLabel>
	<skos:altLabel xml:lang="en">isotope</skos:altLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q108149"/>
</rdf:Description>

