	<skos:exactMatch rdf:resource="https://w3id.org/geochem/1.0/analyticalmethod/neutronactivationanalysis"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300081742"/>
</rdf:Description>

