<rdf:Description rdf:about="http://vocab.terralid.org#c_912285bf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Determination of the chemical composition by electron-induced wavelength dispersive X-ray spectrometry in a microprobe.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
