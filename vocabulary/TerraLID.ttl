<rdf:Description rdf:about="http://vocab.terralid.org#c_461a3e6b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The term is used rather loosely here to describe any material that is used for colouring another material.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">pigment</skos:prefLabel>
	<skos:altLabel xml:lang="en">dye</skos:altLabel>
	<skos:altLabel xml:lang="en">paint</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9dd8c641"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_62b205ba"/>
