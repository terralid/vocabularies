	<skos:broadMatch rdf:resource="https://www.wikidata.org/wiki/Q112259854"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_85bc0576">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Determination of the chemical composition by the wavelength dispersive spectroscopy of X-ray fluorescence.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">WD-XRF</skos:prefLabel>
