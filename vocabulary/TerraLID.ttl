<rdf:Description rdf:about="http://vocab.terralid.org#c_475e1a3a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Area collecting refuse predominantly originating from human occupational activities.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">midden</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9bf30dd9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300120507"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1152199"/>
