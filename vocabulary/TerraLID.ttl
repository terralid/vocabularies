<rdf:Description rdf:about="http://vocab.terralid.org#c_6d29fe63">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An isolated item, seemingly unrelated to any structure or other traces of human activity.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">single find</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_99186ef5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An isolated structure assumedly originating from human activity. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">isolated feature</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1f2bd128">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A natural opening in the earth large enough for humans to explore and sometimes also to use. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cave</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_823bba89"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300008746"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q35509"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4d90feaa">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A single body of naturally occurring and genetically connected material with an anomalous concentration of a mineral or rock type that has potential for human utilisation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">deposit</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_823bba89"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/deposit"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q15104915"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_177cd232">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A single body of naturally occurring and genetically connected material of any concentration that might have potential for human utilisation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">occurrence</skos:prefLabel>
	<skos:altLabel xml:lang="en">mineralisation</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_823bba89"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/occurrence"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a790da1a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An informal grouping of mineral deposits commonly used for reporting. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mining project</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0e020c21"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/project"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4fba9c43">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An area characterised by several geologically related mineral occurrences. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">field</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_823bba89"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/field"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b01341cd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An area characterised by several geologically related mineral occurrences with potential of human utilisation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">locality</skos:prefLabel>
	<skos:altLabel xml:lang="en">mining prospect</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_823bba89"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/prospect"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9db8b2d9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An occurrence that is accessible on the ground. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">outcrop</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_177cd232"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q531953"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6d1e6826">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Remains of human activities carried out to create and maintain a controlled fire without any dedicated architectural remains.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">hearth</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_com/concepts/138029"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q585473"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_16c0c950">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A hole dug to include a timber post, usually with its packing. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">post hole</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_com/concepts/138109"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1af01438">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A negative feature dug into the ground. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">pit</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300008027"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_536290b6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Material used to fill in a negative feature in the ground. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">infilling</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300264840"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q125275846"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8f51e8b9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A pit dug in the ground to store materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">storage pit</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0fab0ef9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Grouping of items or specimens resulting from human activity for archaeological materials or environmental and tectonic processes for geological materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">assemblage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300241507"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300256847"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d0a53b23">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Accumulations of objects according to certain topics or characteristics that do not necessarily share a common provenance. </skos:definition>
	<skos:scopeNote xml:lang="en">Intended to be used only for objects and samples with unknown archaeological context. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">collection</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300025976"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2668072"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_665746e2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Objects that are intended to be always used or present in connection with other components, such as a rivet. </skos:definition>
	<skos:scopeNote xml:lang="en">Intended to identify assemblages resulting from the detachment of previously combined components which are recorded individually. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">components</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300241583"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1310239"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5f8d30a4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Group of objects that were accumulated with the aim to be buried or hidden. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">hoard</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300195474"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q164099"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5f249aa8">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A single object. </skos:definition>
	<skos:scopeNote xml:lang="en">Intended to identify that the items does not belong to an assemblage, or that the assemblage contains only one item. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">item</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300404024"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_db7df3e1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Objects purposely combined to be used as group. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">set</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300133146"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e6cf20b1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The outcropping, heavily weathered part of a mineralisation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">gossan</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-expression/gossan"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q639293"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b81f7872">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A rock whose chemical or mineralogical composition is changed by hydrothermal solutions. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration product (hydrothermal)</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_d5356583"/>
	<skos:broadMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f4468f4e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A rock whose chemical or mineralogical composition is changed by weathering. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">alteration product (supergene)</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_d5356583"/>
	<skos:broadMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9c0fc70d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The country rock or rock body in which a mineralisation occurs.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">host rock</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_235c43fb"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/host-rock"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4dffb82b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material that is extracted from a mineralisation because of its economic value.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ore</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore"/>
	<skos:exactMatch rdf:resource="https://vocabs.acdh.oeaw.ac.at/oeai-materials/concept23771"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/raw-material-role/ore"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300152583"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1823779e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material that is extracted from a mineralisation because of its economic value that was not altered by hydrothermal processes or weathering. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">primary ore</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4dffb82b"/>
	<skos:broadMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_adc64d1b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material that is extracted from a mineralisation because of its economic value that was altered by hydrothermal processes or weathering. The term usually refers to ore that became enriched in the targeted elements because of alteration processes. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">secondary ore</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4dffb82b"/>
	<skos:broadMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_25814b64">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The section of the host rock that was affected by epigenetic processes resulting in the mineralisation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">wall rock</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0fab0ef9"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_888076c5"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/wall-rock"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e95a9fbf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">discovery activity</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000023"/>
	<skos:relatedMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/147298"/>
	<skos:relatedMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/147297"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_84c6c6e0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The incidental discovery (and recovery) of materials of interest. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">stray find</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/146344"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_eb09b8cd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Drilling into the ground with the aim to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">borehole survey</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145112"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_410a0d02">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Drilling into the ground with the aim to retrieve the content of the borehole as a whole. The material will subsequently be used to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">core drilling</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_eb09b8cd"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/exploration-activity-type/core-drilling"/>
	<skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/ExplorationActivityTypeValue/coreDrilling"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_19639bab">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Drilling into the ground with the aim to retrieve the content of the borehole as loose material to retrieve samples. In some cases, it can be used to infer stratigraphy and subsurface features of archaeological and geological features.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">auger drilling</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_eb09b8cd"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/exploration-activity-type/auger-drilling"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145111"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3f471934">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The use of a metal detector to discover artefacts. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">metal detecting</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q111047657"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145147"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145148"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cd2a7865">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Controlled and documented intrusive fieldwork with the aim to record an site and to retrieve samples and artefacts from the site. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">excavation</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145129"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/exploration-activity-type/excavation"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300266151"/>
	<skos:closeMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145160"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8eff20cd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Controlled and documented intrusive fieldwork with the aim to answer a specific research question by recording an site and retrieving samples and artefacts from the site. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">research excavation</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_cd2a7865"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/147305"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f39b79f2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Controlled and documented intrusive fieldwork with the aim to record an site under threat of destruction and to retrieve samples and artefacts from the site under strict time constraints. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">rescue excavation</skos:prefLabel>
	<skos:altLabel xml:lang="en">salvage excavation</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_cd2a7865"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/145157"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q101008619"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6a6e0a7f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Controlled and documented intrusive fieldwork with the aim to record an underwater site and to retrieve samples and artefacts from the site. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">underwater excavation</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_cd2a7865"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/163244"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ae4a0583">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Non-intrusive fieldwork to document the extent and layout of a site through recording the position and distribution of specimens and artefacts.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">survey</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/agl_et/concepts/170654"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2758f3b1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The economic extraction of georesources from the earth. This includes surface and underground operations. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mining</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mining-activity"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q44497"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_77f07bb9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Mining activities in preparation to establishing a full-scale mining operation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">explorative mining activities</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:closeMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/exploration-activity-type/mine-workings-reconnaissance"/>
	<skos:closeMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/exploration-activity-type/mining-pilot"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_074a675c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The systematic survey on an area with the aim to identify the presence of potentially economically viable mineralisations. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ore prospection</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d0e965f6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Uncontrolled and usually undocumented intrusive fieldwork with the aim to collected artefacts. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">illicit digging</skos:prefLabel>
	<skos:altLabel xml:lang="en">looting</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e95a9fbf"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q15624851"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ca223f0b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Information about whether an (archaeological) context includes material from a single depositional event and whether the context is impacted by any post-depositional processes. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">context type</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0541320f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The context represents a single depositional event with all material coming from the same source and no interaction happening after its deposition. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">undisturbed context</skos:prefLabel>
	<skos:altLabel xml:lang="en">primary context</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_ca223f0b"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q136826284"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0faa6b29">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material in the context represents multiple depositional events or it was interacted with after its deposition. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">disturbed context</skos:prefLabel>
	<skos:altLabel xml:lang="en">secondary context</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_ca223f0b"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q136826785"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9408f513">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material in the context represents multiple depositional events or it was interacted with humans being the responsible agents. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">anthropogenically disturbed</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0faa6b29"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1c4bfb96">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material in the context represents multiple depositional events or it was interacted with non-humans being the responsible agents (e.g. bioturbidation).</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">biogenically disturbed</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0faa6b29"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a0ae7ce8">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The context represents a single depositional event with material coming from multiple sources and no interaction happening after its deposition. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mixed context</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_ca223f0b"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b53eb953">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material the object is stored in. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">sample housing</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000017"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1a3ca880">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A container made of thick stiff pasteboard with either a lid or a foldable parts on its top for closing it. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cardboard box</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300215468"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300200342"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6fedae89">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A cardboard box certified to be acid free. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">acid-free cardboard box</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_1a3ca880"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ae7c0b8c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A cardboard box not certified to be acid free. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">non acid-free cardboard box</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_1a3ca880"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_518ec832">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A tube with a hinged sealing cap made of (shatterproof) plastics. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Eppendorf tube</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300198822"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1933961"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e7fdebfb">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A vial made of glass and closed with a lid, often made of plastics. They come in various shapes and sizes and with various types of lids. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">glass vial</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300198822"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3bb341cf">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A vial with lid made of PTFE or Teflon. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">PTFE/Teflon vial</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300198822"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0e85ae39">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The objects are not stored in a container, usually because of their size and/or weight. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">no housing</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f641a35c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A usually non-sealable flexible container made of plastics. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">plastics bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300194509"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cbbc3d94">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A flexible container made of woven material. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">fabric bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300194509"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_10420b12">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A re-sealable storage made of plastics, usually polyethylene (PE). </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ziplock bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_f641a35c"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300194509"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ccf5461d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A fabric bag with cotton as material for the fabric. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cotton fabric bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_cbbc3d94"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f26d0d8c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A fabric bag with cotton as material for the fabric. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">plastics fabric bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_f641a35c"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_cbbc3d94"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_850e4a23">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A flexible container made of paper. Includes envelopes, which are paper bags that can be seabled by some sort of pre-applied adhesive on the closing flap.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">paper bag</skos:prefLabel>
	<skos:altLabel xml:lang="en">paper envelope</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300194509"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q379754"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_77b00da1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A paper bag or envelope certified to be acid free. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">acid-free paper bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_850e4a23"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a1f7691a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A paper bag or envelope not certified to be acid free. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">non acid-free paper bag</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_850e4a23"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_c56bc948">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A cabinet with at least one transparent part specifically designed to present objects to a visitor, e.g. in a museum exhibition. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">display case</skos:prefLabel>
	<skos:altLabel xml:lang="en">showcase</skos:altLabel>
	<skos:altLabel xml:lang="en">vitrine</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_b53eb953"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300077356"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q3561331"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d9a8b325">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A display case equipped to control the environment in it (e.g., temperature, humidity, chemical pollutants). </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">controlled environment display case</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c56bc948"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e1c7a89c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A display case not equipped to control the environment in it. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">uncontrolled environment display case</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c56bc948"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6eeee275">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The different stages an object undergoes after its collection in the field. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">object life cycle stage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_20b5f585">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is stored in a place to keep it safe in the long term. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">storage stage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000011"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_6eeee275"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300056390"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_084b00a4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is brought back to its original shape as much as possible, often with addition of missing parts. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">restoration stage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000011"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_6eeee275"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300053742"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5282dab3">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is treated in a conservation laboratory to stop ongoing deterioation and to prepare it for long-term storage. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">conservation stage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000011"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_6eeee275"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300404519"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_75b32326">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object undergoes limited treatment in the field such as washing or basic convservation measures. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">finds processing stage</skos:prefLabel>
	<skos:altLabel xml:lang="en">in-situ conservation</skos:altLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000011"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_6eeee275"/>
	<skos:relatedMatch rdf:resource="http://vocab.getty.edu/aat/300404519"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_687c5f00">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object did not received any treatment (yet) since its discovery. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">discovery stage</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000011"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_6eeee275"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300404386"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_33bebd59">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is under investigation in a laboratory. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">laboratory stage</skos:prefLabel>
