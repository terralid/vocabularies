<rdf:Description rdf:about="http://vocab.terralid.org#c_ef46e5df">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Gemeinsame Normdatei (GND, Integrated Authority File) of the German National Library provides authoritative data on a wide range of topics, among them persons, corporate bodies and geographic entities. Its main target groups are libraries who used it for cataloguing their publication. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">GND</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_062fe0b0"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q54506313"/>
	<dct:references rdf:resource="https://www.dnb.de/EN/Professionell/Standardisierung/GND/gnd_node.html"/>
</rdf:Description>

