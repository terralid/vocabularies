<rdf:Description rdf:about="http://vocab.terralid.org#c_5df8720f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object or material was completely destroyed (e.g., during analysis or in a destruction event) with records for this event being available. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">destroyed</skos:prefLabel>
