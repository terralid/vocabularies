<rdf:Description rdf:about="http://vocab.terralid.org#c_ee038e9e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The object is (predominantly) made of an inorganic vitrous material based on fused silica. </skos:definition>
