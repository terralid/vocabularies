<rdf:Description rdf:about="http://vocab.terralid.org#c_99ef8f93">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A includes the part B</skos:definition>
	<skos:scopeNote xml:lang="en">Primarily this relation is applied to container-contained type relationships. May be used for individual software modules; note that code repository-to-version relationships should be modeled using IsVersionOf and HasVersion</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">HasPart</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:note xml:lang="en">Recommended for discovery.</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#haspart"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_43052c1f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is a portion of B; may be used for elements of a series</skos:definition>
	<skos:scopeNote xml:lang="en">Primarily this relation is applied to container-contained type relationships. May be used for individual software modules; note that code repository-to-version relationships should be modeled using IsVersionOf and HasVersion</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsPartOf</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:note xml:lang="en">Recommended for discovery.</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#ispartof"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_36fff7dd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is a previous edition of B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsPreviousVersionOf</skos:prefLabel>
