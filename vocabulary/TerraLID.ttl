<rdf:Description rdf:about="http://vocab.terralid.org#c_00c534fa">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A natural opening in the earth used to bury deceased humans, sometimes animals.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">burial cave</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_87b21259"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_1f2bd128"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300387008"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q111340496"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d2a764d2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Site with artefacts arranged on a (previous) ground surface. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">artefact scatter</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300451777"/>
