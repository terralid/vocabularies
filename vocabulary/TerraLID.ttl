<rdf:Description rdf:about="http://vocab.terralid.org#c_3ae8c85b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Built structure that allows the movement of goods or people. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">infrastructure</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4327d421"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300386980"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q121359"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_11c6ca85">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Built structure that provides passage over a depression or other structure. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">bridge</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_3ae8c85b"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300007836"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q12280"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3d1e781c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Built structure that connects locations on the ground. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">road</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_3ae8c85b"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300007800"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q34442"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d6f184d2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Place at which resources are extracted from the earth through exacavation activities. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mine</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300000390"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q820477"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_fa1cf9f1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Place at which resources are extracted underground from the earth through excavation activities. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">underground mine</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_d6f184d2"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300000390"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q4232315"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_20e4e9cd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Place at which resources are extracted open-air from the earth through excavation activities. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">open pit mine</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_d6f184d2"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300000390"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q113681824"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0e020c21">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Any structure related to the operation of mines or the processing of the mine's output. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mining-related site</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300000388"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_df11f809">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Structure used to remove economically unviable parts of the material extracted from a mine and to sort it in preparation for smelting. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ore beneficiation site</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0e020c21"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300404101"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5163843b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A depression in the ground caused by mining activity (either open-air working or collapsed underground workings).</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mining sink-hole</skos:prefLabel>
	<skos:altLabel xml:lang="en">pinge</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0e020c21"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9bf30dd9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Areas primarily used for the collection of discarded materials. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">refuse area</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300000824"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e652be5b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Area collecting discarded material from smelting operations. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">slag dump</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0e020c21"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9bf30dd9"/>
	<skos:broadMatch rdf:resource="http://vocab.getty.edu/aat/300000832"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_15466516">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Area collecting discarded material from structures such as buildings or furnaces. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">debris dump</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9bf30dd9"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_143dd859">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Area collecting discarded material from mining activities. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mine dump</skos:prefLabel>
	<skos:altLabel xml:lang="en">spoil tip</skos:altLabel>
	<skos:altLabel xml:lang="en">spoil pile</skos:altLabel>
