	<skos:exactMatch rdf:resource="https://w3id.org/geochem/1.0/analyticalmethod/emissionspectrometry"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f7856e7e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Analytical methods using the characteristic X-ray spectra of chemical elements for identification and quantification. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">X-ray spectrometry</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c1c261a2"/>
	<skos:exactMatch rdf:resource="https://w3id.org/geochem/1.0/analyticalmethod/xrayspectrometry"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q901775"/>
