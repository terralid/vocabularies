<rdf:Description rdf:about="http://vocab.terralid.org#c_4bf47ef2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Determination of the chemical composition by traditional chemical methods. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">wet chemistry</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c1c261a2"/>
	<skos:exactMatch rdf:resource="https://w3id.org/geochem/1.0/analyticalmethod/wetchemistry"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2963660"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a6a0ae84">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
