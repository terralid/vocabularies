	<skos:exactMatch rdf:resource="https://w3id.org/geochem/1.0/analyticalmethod/energydispersivexrayfluorescencespectrometry"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q112259854"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f1be908f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Determination of the chemical composition by the energy dispersive spectroscopy of X-ray fluorescence with a handheld instrument.</skos:definition>
