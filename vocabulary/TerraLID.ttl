</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2344bc38">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Determination of the chemical composition by electron-induced energy-dispersive X-ray spectrometry in a scanning electron microscope.</skos:definition>
