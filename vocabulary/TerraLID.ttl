<rdf:Description rdf:about="http://vocab.terralid.org#c_14f0b363">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The measurement of the released stored energy in a material in the form of light to determine the material's age. </skos:definition>
