<rdf:Description rdf:about="http://vocab.terralid.org#c_6510b31c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is used as a source of information by B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsReferencedBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:note xml:lang="en">Recommended for discovery.</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isreferencedby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_50fb5931">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is published inside B, but is independent of other things published inside of B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsPublishedIn</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#ispublishedin"/>
