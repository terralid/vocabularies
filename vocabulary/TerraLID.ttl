</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f1f818b8">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The unspecified fraction of an compound as a fraction of 100.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">%</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">percent</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q11229"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_69a07382">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The ratio of the number of atoms of one element to the total number of atoms, expressed as percent.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">at%</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">atom percent</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_bc79dc60">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mass fraction of an element expressed as percent. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">wt%</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">weight percent</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q110162802"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cb4c170e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mass of the measurant expressed as one part per 1000000000 parts. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">µg/kg</skos:prefLabel>
	<skos:altLabel xml:lang="en">ppb</skos:altLabel>
	<skos:altLabel xml:lang="en">ng/g</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">microgram per kilogram</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="en">microgramme per kilogramme</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
	<skos:exactMatch rdf:resource="http://qudt.org/vocab/unit/MicroGM-PER-KiloGM"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3b8ef5ef">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mass of the measurant expressed as one part per million parts. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">µg/g</skos:prefLabel>
	<skos:altLabel xml:lang="en">ppm</skos:altLabel>
	<skos:altLabel xml:lang="en">mg/kg</skos:altLabel>
	<skos:hiddenLabel xml:lang="en">microgram per gram</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="en">microgramme per gramme</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
	<skos:exactMatch rdf:resource="http://qudt.org/vocab/unit/MicroGM-PER-GM"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_815a8de3">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mass fraction of an oxide, expressed as percent. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">oxide%</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">oxide percent</skos:hiddenLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2f3c3933"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q110162802"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8441accd">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The relationship between the mineral and the matrix and other minerals, conveying information about the mineral's formation conditions. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">mineral texture</skos:prefLabel>
	<skos:note xml:lang="en">The terms are mostly taken from U. Neumann (2020), Guide for the microscopical identification of ore and gangue minerals, Tübingen University Press (http://dx.doi.org/10.15496/publikation-38866). However, the definitions are original and based on various sources because the relevant literature, including the aforementioned publication, do not explicitly defines textures but provide examples for them in photomicrographs. </skos:note>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000019"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e74b28a0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The state of interlocking of different mineral grains due to simultaneous crystallisation.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">intergrowth</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_8441accd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_dd1113d4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Large and often lath-shaped euhedral or subhedral crystals are partly or fully included in much larger crystals.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ophitic</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cab80d83">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Filling of interstitial space with a glass or a vitreous phase with small crystals. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">intersertal</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1a4f781a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mineral grew in the interstitial space between grains or structures.  </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">interstitial</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3e50acb7">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Intimate intergrowth of randomly orientated mineral grains with no gaps or cement between them.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">interlocked</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9e0d2c4a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The fine-grained vermicular ("worm-shaped") intergrowth of two minerals, often indicating the breakdown of unstable phases. </skos:definition>
	<skos:scopeNote xml:lang="en">Myrmekitic as specific case of symplectitic texture. Appears to be often used synonymously at least in ore microscopy . </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">symplectitic</skos:prefLabel>
	<skos:altLabel xml:lang="en">vermicular</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5eaf970c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A symplectitic intergrowth of plagioclase and vermicular quartz.</skos:definition>
	<skos:scopeNote xml:lang="en">Myrmekitic as specific case of symplectitic texture. Appears to be often used synonymously at least in ore microscopy . </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">myrmekitic</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_9e0d2c4a"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6655861f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Small grains of one mineral are randomly scattered without common orientation in larger grains of another mineral.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">poikiloblastic</skos:prefLabel>
	<skos:altLabel xml:lang="en">poikilitic</skos:altLabel>
	<skos:altLabel xml:lang="en">sieve texture</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_aa5d33c3">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The mineral is scattered as small grains throughout another mineral or the matrix. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">disseminated</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_436d944e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A mineral grew in the rim of another mineral. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">rimmed</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e5b6f80a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A mineral with irregular outlines and anhedral crystals. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">amoeboid</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_04619e43">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Growth of minerals in small roughly regular-shaped rounded aggregates that resemble the shape of biological cells. Or the porous texture of a rock characterised by abundant openings or cavities, which may or may not be connected.  </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cellular (intergrowth)</skos:prefLabel>
	<skos:altLabel xml:lang="en">porous</skos:altLabel>
	<skos:altLabel xml:lang="en">cavernous</skos:altLabel>
	<skos:altLabel xml:lang="en">vesicular</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_95b262b5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of a ring-shaped mineral around and surrounded by other minerals. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">atoll-like</skos:prefLabel>
	<skos:altLabel xml:lang="en">core texture</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_e74b28a0"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a3d375e7">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of a new or chemically different mineral as a reaction product of the already existing mineral. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">replacement</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_8441accd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f478f111">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An intergrowth of  different minerals in which the larger crystals have a fairly regular geometric outline and orientation, and resemble cuneiform writing or have a thread-like appearance.  </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">filiform</skos:prefLabel>
	<skos:altLabel xml:lang="en">graphic texture</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_52eaf264">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of elongated rounded aggregates of secondary minerals inside the primary mineral, often as a result of alteration of the primary mineral. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">graphic</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8c47dce3">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of minerals replacing the content of cells in originally biological matter such as plants in coal. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cellular (replacement)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7b190793">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The original mineral reacted from the outside, leaving an (island-shaped) unreacted part surrounded by secondary minerals. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">island-shaped</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d78ab7be">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Growth of secondary minerals in cavities and along fracture or cleavage planes from which previously present minerals were removed by e.g. dissolution, creating a network texture resembling stacked boxes or honey-combs. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">boxwork</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_36ca06ef">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Relict of a skeletal crystal of one mineral enclosed in another mineral species.   </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">skeleton-shaped</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d3b9f898">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of a secondary mineral from the grain boundary into the primary minerals, resulting in a grain boundary between both minerals with many scallop-shaped, concave embayments. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cusp-and-caries</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_bb44a01a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The dissolution of small areas of a mineral, often at its rim, resulting in voids. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">lacuna</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7fe5c1ff">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The oriented growth of a secondary mineral in elongated shapes within the primary mineral, usually along cleavage planes, crystal planes, twin boundaries or fractures. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">lamellar</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7d8b3c14">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The evenly-spaced growth of a secondary mineral along the crystallographic orientation of the primary mineral's grain boundary. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">zonal</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_dd91efb2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The replacement of one mineral by another with leaving the outermost original mineral unaffected, and constituting the "atoll". </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">atoll-like (replacement)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d375a5c9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The growth of a dense anhedral alteration mineral in the matrix. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cement-shaped</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0571a899">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A secondary mineral completely replacing the primary mineral while retaining the shape of the primary mineral's grains. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">pseudomorph</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_a3d375e7"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1456639"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_88091e76">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The alteration of minerals through external mechanical stress. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">deformation-related</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_8441accd"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6783bb4e">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The fracturing of a mineral due to intense mechanical stress. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">cataclastic</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_430fd693">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The fragmentation of a mineral resulting in various angular fragments </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">brecciated</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_03b13243">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The fragmentation of a mineral. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">broken</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3136dfed">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The internal deformation of a mineral's crystal due to translational forces, resulting in the re-orientation of some areas in the crystal along crystal planes unrelated to the crystallographic axes</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">translation lamellae</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7067812d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The internal deformation of a mineral's crystal due to translational forces, resulting in the re-orientation of some areas in the crystal along crystal planes along its crystallographic axes. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">pressure twins</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_c8069a37">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The ductile transformation of a mineral into a bent shape (i.e., without breaking it). </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">bending</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ed4b7838">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The transformation of elongated or layered minerals into a (sub)parallel orientation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">planar alignment</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_88091e76"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_0038daae">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Matter of constant and unique chemical composition with characteristic properties. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">chemical substance</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q79529"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7014484c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Chemical substance containing oxygen and one other chemical element. </skos:definition>
	<skos:scopeNote xml:lang="en">List of oxides retrieved from https://www.wikidoc.org/index.php/Oxide</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">oxide</skos:prefLabel>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000003"/>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_0038daae"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q50690"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6e9450ea">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">silver oxide</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">silver oxide</skos:prefLabel>
	<skos:altLabel xml:lang="en">Ag2O</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_7014484c"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q407815"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_69c7ff92">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">silver(II) oxide</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">silver(II) oxide</skos:prefLabel>
	<skos:altLabel xml:lang="en">AgO</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_7014484c"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q12043383"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4b36b188">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">aluminium oxide</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">aluminium oxide</skos:prefLabel>
	<skos:altLabel xml:lang="en">Al2O3</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_7014484c"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q177342"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_87d3476d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">oxidoaluminium</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">oxidoaluminium</skos:prefLabel>
	<skos:altLabel xml:lang="en">AlO</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_7014484c"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q133767"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9e1c013d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">arsenic trioxide</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">arsenic trioxide</skos:prefLabel>
	<skos:altLabel xml:lang="en">As2O3</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_7014484c"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q7739"/>
</rdf:Description>

