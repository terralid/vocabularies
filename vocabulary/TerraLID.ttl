	<skos:definition xml:lang="en">The component of the glass decreasing its transparency. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">opacifier</skos:prefLabel>
