	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300007660"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9dd8c641">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material category of TerraLID used to determine the material-specific metadata.</skos:definition>
