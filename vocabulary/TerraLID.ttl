	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A dating method superseding potassium-argon dating by allowing age determination from a single analysis. This is achieved by converting a controlled amount of the radioactive potassium isotope to a not naturally occurring argon isotope by neutron irradiation. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
