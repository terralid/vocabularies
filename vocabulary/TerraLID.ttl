	<skos:definition xml:lang="en">Built structure (on the ground or into the ground) dedicated to the interment of a deceased human, sometimes animal. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">tomb</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_87b21259"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_com/concepts/138345"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300005926"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q381885"/>
