	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material does not show any indication of corrosion. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">no corrosion</skos:prefLabel>
