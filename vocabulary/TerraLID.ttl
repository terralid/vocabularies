<rdf:Description rdf:about="http://vocab.terralid.org#c_fdeb0d6c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The loss of adhesion of paint from its substrate often but not necessarily in response to changes in the environment like humidity or temperature. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">flaking</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_8469dc11"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q117289087"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_25f0249a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The process by which a material was modified as part of the production process. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">production process</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1408286"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_31f5fc72">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material is exposed to another material from which a specific compound or the entire material gets dissolved into the material. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">absorption</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300053004"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q332828"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f37a4790">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material was exposed to react with its environment and meteoric water.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">weathering</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300054115"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q179177"/>
	<skos:closeMatch rdf:resource="http://vocab.getty.edu/aat/300226583"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6237ab6b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The partial or complete dissolution of all parts of a material when exposed to acids. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">acid reaction</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_5916e942">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The dissolution of specific parts of a material by covering or submerging it in a solution such as an acid, solvent, or water.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">leaching</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300053761"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1483184"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a1b2b905">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material was mechanically reduced to smaller particles by applying friction. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">grinding</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300053090"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q26882416"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_22488ba9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The material was exposed to high temperatures.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">heating</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_25f0249a"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300053885"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q4311765"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_38acd1d1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">pigment name</skos:prefLabel>
	<skos:note xml:lang="en">This vocabulary is based on the pigments listed in Eastaugh, N., Walsh, V. (2004). The Pigment compendium: Optical Microscopy of Historic Pigments. Oxford : Elsevier Butterworth-Heinemann</skos:note>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_727afc46">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A Ca-based inorganic and natural pigment with the chemical formula CaSO4.xH2O, where x ~ 0.5-0.8.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">bassanite</skos:prefLabel>
	<skos:altLabel xml:lang="en">calcium sulfate</skos:altLabel>
	<skos:altLabel xml:lang="en">CaSO4.xH2O, where x ~ 0.5-0.8</skos:altLabel>
	<skos:note xml:lang="en">Based on information in Eastaugh, N., Walsh, V. (2004). The Pigment compendium: Optical Microscopy of Historic Pigments. Oxford : Elsevier Butterworth-Heinemann</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_38acd1d1"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q408259"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a9faa87b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A Pb-based inorganic and synthetic pigment with the chemical formula PbCO3.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">synthetic lead carbonate</skos:prefLabel>
	<skos:altLabel xml:lang="en">PbCO3</skos:altLabel>
	<skos:note xml:lang="en">Based on information in Eastaugh, N., Walsh, V. (2004). The Pigment compendium: Optical Microscopy of Historic Pigments. Oxford : Elsevier Butterworth-Heinemann</skos:note>
