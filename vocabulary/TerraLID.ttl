	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_com/concepts/137492"/>
	<skos:exactMatch rdf:resource="http://purl.org/heritagedata/schemes/eh_evd/concepts/151454"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300005907"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q173387"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2e5ac6fa">
