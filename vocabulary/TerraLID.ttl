<rdf:Description rdf:about="http://vocab.terralid.org#c_bafa70d4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A species of atoms defined by its number of protons. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">chemical element</skos:prefLabel>
	<skos:note xml:lang="en">This is a reproduction of a subset of Periodic table of elements (thesaurus) by Institute for scientific and technical information (Inist) - CNRS/UPS76 and published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license at https://loterre.istex.fr/8HQ/en/ .</skos:note>
