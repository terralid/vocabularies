</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4f75cdd5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The type of a resource. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">resourceType</skos:prefLabel>
	<skos:note xml:lang="en">This is a reproduction of a subset of the controlled list resourceTypeGeneral in the DataCite Metadata version schema 4.7. The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000022"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e4111c25">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Any resource not covered by other terms. If selected, provide resource type in metadata field "additional information". </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Other (resourceType)</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#other"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_eb3431d5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A structured series of steps which can be executed to produce a final outcome, allowing users a means to specify and enact their work in a more reproducible manner.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Workflow</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q627335"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#workflow"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9fadd71a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A resource consisting primarily of words for reading that is not covered by any other textual resource type in this list.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Text</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q234460"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#text"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d9a7c870">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A detailed, time-stamped description of a research plan, often openly shared in a registry or published in a journal before the study is conducted to lend accountability and transparency in the hypothesis generating and testing process.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">StudyRegistration</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#studyregistration"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2ac847b2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Something established by authority, custom, or general consent as a model, example, or point of reference.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Standard</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#standard"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_c2b67ae7">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A resource primarily intended to be heard.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Sound</skos:prefLabel>
	<skos:altLabel xml:lang="en">Audio recording</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#sound"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b359ddc1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A computer program other than a computational notebook, in either source code (text) or compiled form. Use this type for general software components supporting scholarly research. Use the “ComputationalNotebook” value for virtual notebooks.</skos:definition>
	<skos:scopeNote xml:lang="en">Software supporting scholarly research</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Software</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q7397"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#software"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_40899a25">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An organized system of apparatus, appliances, staff, etc., for supplying some function(s) required by end users.</skos:definition>
	<skos:scopeNote xml:lang="en">Data management service, or long-term preservation service</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Service</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#service"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_21afb462">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A document that presents information in an organized format for a specific audience and purpose.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Report</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q10870555"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#report"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_78ce6c50">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A planned endeavor or activity, frequently collaborative, intended to achieve a particular aim using allocated resources such as budget, time, and expertise.</skos:definition>
	<skos:scopeNote xml:lang="en">This resource type represents the project and includes research projects and studies. For a project deliverable or description of a project, use the corresponding resource type for the output—e.g., for a project report, dissertation, or study registration, use the resourceTypeGeneral “Report”, “Dissertation”, or “StudyRegistration” instead.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Project</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1172284"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#project"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_945645e4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A version of a scholarly or scientific paper that precedes formal peer review and publication in a peer-reviewed scholarly or scientific journal.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Preprint</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q580922"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#preprint"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1e1210c6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A physical object or substance.</skos:definition>
	<skos:scopeNote xml:lang="en">Artifacts, specimens, material samples, and features-of-interest of any size. Note that digital representations of physical objects should use one of the other resourceTypeGeneral values.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">PhysicalObject</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q223557"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#physicalobject"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_192f8727">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Evaluation of scientific, academic, or professional work by others working in the same field.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">PeerReview</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q215028"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#peerreview"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_c5e4fd1c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A formal document that outlines how research outputs are to be handled both during a research project and after the project is completed.</skos:definition>
	<skos:scopeNote xml:lang="en">Includes data, software, and materials.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">OutputManagementPlan</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#outputmanagementplan"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_095c193d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">An abstract, conceptual, graphical, mathematical or visualization model that represents empirical objects, phenomena, or physical processes.</skos:definition>
	<skos:scopeNote xml:lang="en">Modelled descriptions of, for example, different aspects of languages or a molecular biology reaction chain</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Model</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#model"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b0ef03ef">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A written composition on a topic of interest, which forms a separate part of a journal.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">JournalArticle</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:closeMatch rdf:resource="https://www.wikidata.org/wiki/Q13442814"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#journalarticle"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_15f86bc5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A scholarly publication consisting of articles that is published regularly throughout the year.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Journal</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q737498"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#journal"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_6d0e1459">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A resource requiring interaction from the user to be understood, executed, or experienced.</skos:definition>
	<skos:scopeNote xml:lang="en">Training modules, files that require use of a viewer (e.g., Flash), or query/response portals</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">InteractiveResource</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#interactiveresource"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d40d5def">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A device, tool or apparatus used to obtain, measure and/or analyze data.</skos:definition>
	<skos:scopeNote xml:lang="en">Note that this is meant to be the instrument instance, e.g., the individual physical device, not the digital description or design of an instrument.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Instrument</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#instrument"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d16e61fe">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A visual representation other than text.</skos:definition>
	<skos:scopeNote xml:lang="en">Digitised or born digital images, drawings or photographs</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Image</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_4f75cdd5"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q478798"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#image"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4229295c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A non-persistent, time-based occurrence.</skos:definition>
	<skos:scopeNote xml:lang="en">Descriptive information and/or content that is the basis for discovery of the purpose, location, duration, and responsible agents associated with an event such as a webcast or convention.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Event</skos:prefLabel>
