<rdf:Description rdf:about="http://vocab.terralid.org#c_87b21259">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Site primarily used to bury deceased humans, sometimes also animals.</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">funerary site</skos:prefLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_241d96ca"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_269c18b5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Site with burials of deceased humans, sometimes animals. </skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">burial ground</skos:prefLabel>
	<skos:altLabel xml:lang="en">cemeteries</skos:altLabel>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_87b21259"/>
	<skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300266755"/>
