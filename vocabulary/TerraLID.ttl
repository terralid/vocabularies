<rdf:Description rdf:about="http://vocab.terralid.org#c_4a54f6dc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The determination of chemical concentrations from the radioactivity produced by the sample material after its irradiation with neutrons through comparison with the radioactivity measured in standard materials of comparable sample matrix. </skos:definition>
