	<skos:note xml:lang="en">This is a reproduction of the controlled list relatedIdentifierType in the DataCite Metadata version schema 4.7. </skos:note>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000022"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q853614"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f260a576">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Mostly used to publish vocabularies and ontologies. The letters ‘w3’ stand for “World Wide Web”.</skos:definition>
	<skos:example xml:lang="en">https://w3id.org/games/spec/coil#Coil_Bomb_Die_Of_Age</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">w3id</skos:prefLabel>
	<skos:altLabel xml:lang="en">Permanent identifier for Web applications</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#w3id"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_efbf8c56">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique and persistent identifier of an electronic document. The syntax is: urn:&lt;NID&gt;:&lt;NSS&gt;. The leading urn: sequence is case-insensitive, &lt;NID&gt; is the namespace identifier, &lt;NSS&gt; is the namespace-specific string.</skos:definition>
	<skos:example xml:lang="en">urn:nbn:de:101:1-201102033592</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">URN</skos:prefLabel>
	<skos:altLabel xml:lang="en">Uniform Resource Name</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q76497"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#urn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cca94dd2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Also known as web address, a URL is a specific character string that constitutes a reference to a resource. The syntax is: scheme://domain:port/path?query_string#fragment_id.</skos:definition>
	<skos:example xml:lang="en">http://www.heatflow.und.edu/index2.html</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">URL</skos:prefLabel>
	<skos:altLabel xml:lang="en">Uniform Resource Locator</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q42253"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#url"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_49ebd1fc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A barcode symbology used for tracking trade items in stores. Its most common form, the UPC-A, consists of 12 numerical digits.</skos:definition>
	<skos:example xml:lang="en">123456789999</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">UPC</skos:prefLabel>
	<skos:altLabel xml:lang="en">Universal Product Code</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1193047"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#upc"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b573f515">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique and persistent identifier for software code artifacts commonly found in version control systems such as code files and commits available in the Software Heritage Archive. It consists of the mandatory identifier of the record in the Software Heritage archive and an optional list of qualifiers to provide information about the object’s context. </skos:definition>
	<skos:example xml:lang="en">swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">SWHID</skos:prefLabel>
	<skos:altLabel xml:lang="en">SoftWare Hash Identifier </skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q134567344"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#swhid"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_96a8c2b8">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A character string used to uniquely identify key inputs to an experiment including the so-called “key biological resources” as defined by the National Institutes of Health, and related tools such as core facilities and databases. An RRID name is divided into two parts, the authority and a local identifier, separated by an underscore.</skos:definition>
	<skos:example xml:lang="en">RRID:SCR_014641</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">RRID</skos:prefLabel>
	<skos:altLabel xml:lang="en">Research Resource IDentifier</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q107278278"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#rrid"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b10276d1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique and persistent identifier for research projects. </skos:definition>
	<skos:example xml:lang="en">https://raid.org/10.26259/5c43ca8f</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">RAiD</skos:prefLabel>
	<skos:altLabel xml:lang="en">Research Activity Identifier </skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#raid"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ff6b1f44">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A PURL has three parts: (1) a protocol, (2) a resolver address, and (3) a name.</skos:definition>
	<skos:example xml:lang="en">http://purl.oclc.org/foo/bar</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">PURL</skos:prefLabel>
	<skos:altLabel xml:lang="en">Persistent Uniform Resource Locator</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q195305"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#purl"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_491eec33">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique number assigned to each PubMed record.</skos:definition>
	<skos:example xml:lang="en">12082125</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">PMID</skos:prefLabel>
	<skos:altLabel xml:lang="en">PubMed identifier</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q2082879"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#pmid"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_19665f86">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique identifier for data in the Life Science domain. Format: urn:lsid:authority:namespace:identifier:revision.</skos:definition>
	<skos:example xml:lang="en">urn:lsid:ubio.org:namebank:11815</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">LSID</skos:prefLabel>
	<skos:altLabel xml:lang="en">Life Science Identifiers</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q6459954"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#lsid"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_036b6cbe">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:example xml:lang="en">The linking ISSN or ISSN-L enables collocation or linking among different media versions of a continuing resource.</skos:example>
	<skos:example xml:lang="en">1188-1534</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">LISSN</skos:prefLabel>
	<skos:altLabel xml:lang="en">Linking ISSN</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#lissn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a61ff4a5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique “number” assigned to a textual work. An ISTC consists of 16 numbers and/or letters.</skos:definition>
	<skos:example xml:lang="en">0A9 2002 12B4A105 7</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ISTC</skos:prefLabel>
	<skos:altLabel xml:lang="en">International Standard Text Code</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q1666944"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#istc"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_23aeb12c">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique 8-digit number used to identify a print or electronic periodical publication.</skos:definition>
	<skos:example xml:lang="en">0077-5606</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ISSN</skos:prefLabel>
	<skos:altLabel xml:lang="en">International Standard Serial Number</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q131276"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#issn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_664844dc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A unique numeric book identifier. There are 2 formats: a 10-digit ISBN format and a 13-digit ISBN.</skos:definition>
	<skos:example xml:lang="en">978-3-905673-82-1</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ISBN</skos:prefLabel>
	<skos:altLabel xml:lang="en">International Standard Book Number</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q33057"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#isbn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_bb41a882">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A code that uniquely identifies samples from our natural environment and related features-of-interest.</skos:definition>
	<skos:example xml:lang="en">IECUR0097</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IGSN</skos:prefLabel>
	<skos:altLabel xml:lang="en">International Generic Sample Number</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q17058352"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#igsn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_db36371f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">This refers specifically to an ID in the Handle system operated by the Corporation for National Research Initiatives (CNRI).</skos:definition>
	<skos:example xml:lang="en">10013/epic.10033</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Handle</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:relatedMatch rdf:resource="https://www.wikidata.org/wiki/Q3126718"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#handle"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9cdedeb0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">ISSN used to identify periodicals in electronic form (eISSN or e-ISSN).</skos:definition>
	<skos:example xml:lang="en">1562-6865</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">EISSN</skos:prefLabel>
	<skos:altLabel xml:lang="en">Electronic International Standard Serial Number</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#eissn"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_91caa317">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A 13-digit barcoding standard that is a superset of the original 12-digit Universal Product Code (UPC) system.</skos:definition>
	<skos:example xml:lang="en">9783468111242</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">EAN13</skos:prefLabel>
	<skos:altLabel xml:lang="en">European Article Number</skos:altLabel>
	<skos:altLabel xml:lang="en">International Article Number</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:note xml:lang="en">Now renamed International Article Number, but retaining the original acronym.</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q357404"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#ean13"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_cc3c0083">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A character string used to uniquely identify an object. A DOI name is divided into two parts, a prefix and a suffix, separated by a slash.</skos:definition>
	<skos:example xml:lang="en">10.1016/j.epsl.2011.11.037</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">DOI</skos:prefLabel>
	<skos:altLabel xml:lang="en">Digital Object Identifier</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q25670"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#doi"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_e3b9ba37">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">CSTR is an identifier based on the Chinese National Standard GB/T 32843—2016 “Science and technology resource identification”, providing a unique identification service for scientific data, papers, scientific institutions, researchers, scientific instruments, patents and other scientific and technological resources.</skos:definition>
	<skos:example xml:lang="en">31253.11.sciencedb.13238</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">CSTR</skos:prefLabel>
	<skos:altLabel xml:lang="en">Common Science and Technology Resources Identifier</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q124257084"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#cstr"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_58ef12c9">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A standardized 19-character identifier according to the syntax yyyyjjjjjvvvvmppppa. See http://info-uri.info/registry/OAIHandler?verb=GetRecord&amp;metadataPrefix=reg&amp;identifier=info:bibcode/.</skos:definition>
	<skos:example xml:lang="en">2018AGUFM.A24K..07S</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">bibcode</skos:prefLabel>
	<skos:altLabel xml:lang="en">Astrophysics Data System bibliographic codes</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:note xml:lang="en">bibcodes can be searched via https://ui.adsabs.harvard.edu/ or resolved using https://ui.adsabs.harvard.edu/abs/&lt;bibcode&gt;.</skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q25754"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#bibcode"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_14d152fa">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">arXiv.org is a repository of preprints of scientific papers in the fields of mathematics, physics, astronomy, computer science, quantitative biology, statistics, and quantitative finance.</skos:definition>
	<skos:example xml:lang="en">arXiv:0706.0001</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ArXiv</skos:prefLabel>
	<skos:altLabel xml:lang="en">arXiv identifier</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<skos:exactMatch rdf:resource="https://www.wikidata.org/wiki/Q118398"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#arxiv"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9c7b1aa6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A URI designed to support long-term access to information objects. In general, ARK syntax is of the form (brackets, []. indicate optional elements): [http://NMA/]ark:/NAAN/Name [Qualifier].</skos:definition>
	<skos:example xml:lang="en">ark:/13030/tqb3kh97gh8w</skos:example>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">ARK</skos:prefLabel>
	<skos:altLabel xml:lang="en">Archival Resource Key</skos:altLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_c8cb9106"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relatedIdentifierType/#ark"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_2c9da0f0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Describes a relationship between the source being regstered (A) and the related source (B).</skos:definition>
	<skos:scopeNote xml:lang="en">Within TerraLID, the related source (B) is always the entity in TerraLID. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:topConceptOf rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">relationType</skos:prefLabel>
	<skos:note xml:lang="en">This is a reproduction of the controlled list relationType in the DataCite Metadata version schema 4.7. The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="https://vocabs.dariah.eu/bbt/Concept/000024"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_42798d88">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A has a translation B</skos:definition>
	<skos:scopeNote xml:lang="en">When a resource is shared in one language, then later translated to another, use “HasTranslation” to link the original resource to its translation. When a resource is released at the same time in multiple languages, use “HasTranslation” to connect the works to each other in both directions.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">HasTranslation</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#hastranslation"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_3e9a7d5d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is a translation of B</skos:definition>
	<skos:scopeNote xml:lang="en">When a resource is shared in one language, then later translated to another, use “IsTranslationOf” to link the translation to the original.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsTranslationOf</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#istranslationof"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_50f18eec">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A collects B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used to indicate the relationship between an instrument and where it has been used to collect, measure, obtain, or observe data (as in, instrument A collects dataset B).</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Collects</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#collects"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_7209d768">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is collected by B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used to indicate the relationship between a dataset and an instrument that is used to collect, measure, obtain, or observe data (as in, dataset A is IsCollectedBy instrument B).</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsCollectedBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#iscollectedby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_b87ae52a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is replaced by B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsObsoletedBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isobsoletedby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_a03285c1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A replaces B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Obsoletes</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#obsoletes"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_83af8ee5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A requires B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used to indicate software dependencies.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Requires</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#requires"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f0352501">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is required by B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used to indicate software dependencies.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsRequiredBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isrequiredby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d7654681">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is a source upon which B is based</skos:definition>
	<skos:scopeNote xml:lang="en">IsSourceOf is the original resource from which a derivative resource was created.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsSourceOf</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#issourceof"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8aa44c44">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates B is a source upon which A is based</skos:definition>
	<skos:scopeNote xml:lang="en">IsDerivedFrom should be used for a resource that is a derivative of an original resource.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsDerivedFrom</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isderivedfrom"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_1565380d">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates that A is a review of B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Reviews</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#reviews"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_8941e0d4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates that A is reviewed by B</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsReviewedBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isreviewedby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_58ed789b">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates that A is identical to B, for use when there is a need to register two separate instances of the same resource</skos:definition>
	<skos:scopeNote xml:lang="en">IsIdenticalTo should be used for a resource that is the same as the registered resource but is saved on another location, maybe another institution.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsIdenticalTo</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isidenticalto"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_f214a28f">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is the original form of B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used for different software operating systems or compiler formats, for example.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsOriginalFormOf</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isoriginalformof"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_4ccf0580">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is a variant or different form of B</skos:definition>
	<skos:scopeNote xml:lang="en">Use for a different form of one thing. May be used for different software operating systems or compiler formats, for example.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsVariantFormOf</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isvariantformof"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_ad976a89">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates B is the result of a compile or creation event using A</skos:definition>
	<skos:scopeNote xml:lang="en">May be used for software and text, as a compiler can be a computer program or a person.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Compiles</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#compiles"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_38b56cad">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates B is used to compile or create A</skos:definition>
	<skos:scopeNote xml:lang="en">May be used to indicate either a traditional text compilation, or the compiler program used to generate executable software.</skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsCompiledBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#iscompiledby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_85ea27dc">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates A is documentation about/explaining B</skos:definition>
	<skos:scopeNote xml:lang="en">May be used for software documentation. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">Documents</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#documents"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_d85f7b3a">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates B is documentation about/explaining A</skos:definition>
	<skos:scopeNote xml:lang="en">May be used for software documentation. </skos:scopeNote>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">IsDocumentedBy</skos:prefLabel>
	<skos:note xml:lang="en">The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. </skos:note>
	<skos:broader rdf:resource="http://vocab.terralid.org#c_2c9da0f0"/>
	<dct:references rdf:resource="https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/relationType/#isdocumentedby"/>
</rdf:Description>

<rdf:Description rdf:about="http://vocab.terralid.org#c_9e3bfeb6">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">indicates B is used as a source of information for A</skos:definition>
	<skos:inScheme rdf:resource="http://vocab.terralid.org#conceptScheme_a0559f69"/>
	<skos:prefLabel xml:lang="en">References</skos:prefLabel>
