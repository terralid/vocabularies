  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000019> .

:c_80dcdedf a skos:Concept;
  skos:definition "The material was not altered after its initial production from raw materials. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "primary"@en;
  skos:broader :c_f5cb57a0 .

:c_d179db0a a skos:Concept;
