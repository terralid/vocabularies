  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "recycling indicator"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000019> .

:c_08e80a7e a skos:Concept;
  skos:definition "Indications for a conversion of one or several materials into the object exist but do not warrant a confirmation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "recycling suspected"@en;
  skos:broader :c_e4626b4d .

:c_3a6292d6 a skos:Concept;
  skos:definition "The material is not the result of re-using other materials. "@en;
  skos:inScheme :conceptScheme_a0559f69;
