  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "plastics fabric bag"@en;
  skos:broader :c_f641a35c, :c_cbbc3d94 .

:c_850e4a23 a skos:Concept;
  skos:definition "A flexible container made of paper. Includes envelopes, which are paper bags that can be seabled by some sort of pre-applied adhesive on the closing flap."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "paper bag"@en;
  skos:altLabel "paper envelope"@en;
