  skos:prefLabel "Other (resourceType)"@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#other> .

:c_eb3431d5 a skos:Concept;
  skos:definition "A structured series of steps which can be executed to produce a final outcome, allowing users a means to specify and enact their work in a more reproducible manner."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Workflow"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q627335>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#workflow> .

:c_9fadd71a a skos:Concept;
  skos:definition "A resource consisting primarily of words for reading that is not covered by any other textual resource type in this list."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Text"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q234460>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#text> .

:c_d9a7c870 a skos:Concept;
  skos:definition "A detailed, time-stamped description of a research plan, often openly shared in a registry or published in a journal before the study is conducted to lend accountability and transparency in the hypothesis generating and testing process."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "StudyRegistration"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#studyregistration> .

:c_2ac847b2 a skos:Concept;
  skos:definition "Something established by authority, custom, or general consent as a model, example, or point of reference."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Standard"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#standard> .

:c_c2b67ae7 a skos:Concept;
  skos:definition "A resource primarily intended to be heard."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Sound"@en;
  skos:altLabel "Audio recording"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#sound> .

:c_b359ddc1 a skos:Concept;
  skos:definition "A computer program other than a computational notebook, in either source code (text) or compiled form. Use this type for general software components supporting scholarly research. Use the “ComputationalNotebook” value for virtual notebooks."@en;
  skos:scopeNote "Software supporting scholarly research"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Software"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q7397>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#software> .

:c_40899a25 a skos:Concept;
  skos:definition "An organized system of apparatus, appliances, staff, etc., for supplying some function(s) required by end users."@en;
  skos:scopeNote "Data management service, or long-term preservation service"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Service"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#service> .

:c_21afb462 a skos:Concept;
  skos:definition "A document that presents information in an organized format for a specific audience and purpose."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Report"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q10870555>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#report> .

:c_78ce6c50 a skos:Concept;
  skos:definition "A planned endeavor or activity, frequently collaborative, intended to achieve a particular aim using allocated resources such as budget, time, and expertise."@en;
  skos:scopeNote "This resource type represents the project and includes research projects and studies. For a project deliverable or description of a project, use the corresponding resource type for the output—e.g., for a project report, dissertation, or study registration, use the resourceTypeGeneral “Report”, “Dissertation”, or “StudyRegistration” instead."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Project"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1172284>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#project> .

:c_945645e4 a skos:Concept;
  skos:definition "A version of a scholarly or scientific paper that precedes formal peer review and publication in a peer-reviewed scholarly or scientific journal."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Preprint"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q580922>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#preprint> .

:c_1e1210c6 a skos:Concept;
  skos:definition "A physical object or substance."@en;
  skos:scopeNote "Artifacts, specimens, material samples, and features-of-interest of any size. Note that digital representations of physical objects should use one of the other resourceTypeGeneral values."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "PhysicalObject"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q223557>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#physicalobject> .

:c_192f8727 a skos:Concept;
  skos:definition "Evaluation of scientific, academic, or professional work by others working in the same field."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "PeerReview"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q215028>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#peerreview> .

:c_c5e4fd1c a skos:Concept;
  skos:definition "A formal document that outlines how research outputs are to be handled both during a research project and after the project is completed."@en;
  skos:scopeNote "Includes data, software, and materials."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "OutputManagementPlan"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#outputmanagementplan> .

:c_095c193d a skos:Concept;
  skos:definition "An abstract, conceptual, graphical, mathematical or visualization model that represents empirical objects, phenomena, or physical processes."@en;
  skos:scopeNote "Modelled descriptions of, for example, different aspects of languages or a molecular biology reaction chain"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Model"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#model> .

:c_b0ef03ef a skos:Concept;
  skos:definition "A written composition on a topic of interest, which forms a separate part of a journal."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "JournalArticle"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:closeMatch <https://www.wikidata.org/wiki/Q13442814>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#journalarticle> .

:c_15f86bc5 a skos:Concept;
  skos:definition "A scholarly publication consisting of articles that is published regularly throughout the year."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Journal"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q737498>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#journal> .

:c_6d0e1459 a skos:Concept;
  skos:definition "A resource requiring interaction from the user to be understood, executed, or experienced."@en;
  skos:scopeNote "Training modules, files that require use of a viewer (e.g., Flash), or query/response portals"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "InteractiveResource"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#interactiveresource> .

:c_d40d5def a skos:Concept;
  skos:definition "A device, tool or apparatus used to obtain, measure and/or analyze data."@en;
  skos:scopeNote "Note that this is meant to be the instrument instance, e.g., the individual physical device, not the digital description or design of an instrument."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Instrument"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#instrument> .

:c_d16e61fe a skos:Concept;
  skos:definition "A visual representation other than text."@en;
  skos:scopeNote "Digitised or born digital images, drawings or photographs"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Image"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
