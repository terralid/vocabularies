  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#image> .

:c_4229295c a skos:Concept;
  skos:definition "A non-persistent, time-based occurrence."@en;
  skos:scopeNote "Descriptive information and/or content that is the basis for discovery of the purpose, location, duration, and responsible agents associated with an event such as a webcast or convention."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Event"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1656682>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#event> .

:c_3839e9ab a skos:Concept;
  skos:definition "A written essay, treatise, or thesis, especially one written by a candidate for the degree of Doctor of Philosophy."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Dissertation"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1266946>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#dissertation> .

:c_985fe775 a skos:Concept;
  skos:definition "Data encoded in a defined structure."@en;
  skos:scopeNote "Data file or files"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Dataset"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
