  skos:exactMatch <https://www.wikidata.org/wiki/Q618779>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#award> .

:c_30709214 a skos:Concept;
  skos:definition "A series of visual representations imparting an impression of motion when shown in succession. May or may not include sound."@en;
  skos:scopeNote "May be used for films, video, etc."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Audiovisual"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
