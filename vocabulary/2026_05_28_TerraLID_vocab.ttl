  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "storage pit"@en;
  skos:broader :c_241d96ca .

:c_0fab0ef9 a skos:Concept;
  skos:definition "Grouping of items or specimens resulting from human activity for archaeological materials or environmental and tectonic processes for geological materials. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "assemblage"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>;
  skos:broadMatch <http://vocab.getty.edu/aat/300241507>;
  skos:closeMatch <http://vocab.getty.edu/aat/300256847> .

:c_d0a53b23 a skos:Concept;
  skos:definition "Accumulations of objects according to certain topics or characteristics that do not necessarily share a common provenance. "@en;
  skos:scopeNote "Intended to be used only for objects and samples with unknown archaeological context. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "collection"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>, :c_0fab0ef9;
  skos:exactMatch <http://vocab.getty.edu/aat/300025976>, <https://www.wikidata.org/wiki/Q2668072> .

:c_665746e2 a skos:Concept;
  skos:definition "Objects that are intended to be always used or present in connection with other components, such as a rivet. "@en;
  skos:scopeNote "Intended to identify assemblages resulting from the detachment of previously combined components which are recorded individually. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "components"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>, :c_0fab0ef9;
  skos:exactMatch <http://vocab.getty.edu/aat/300241583>, <https://www.wikidata.org/wiki/Q1310239> .

:c_5f8d30a4 a skos:Concept;
  skos:definition "Group of objects that were accumulated with the aim to be buried or hidden. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "hoard"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>, :c_0fab0ef9;
  skos:exactMatch <http://vocab.getty.edu/aat/300195474>, <https://www.wikidata.org/wiki/Q164099> .

:c_5f249aa8 a skos:Concept;
  skos:definition "A single object. "@en;
  skos:scopeNote "Intended to identify that the items does not belong to an assemblage, or that the assemblage contains only one item. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "item"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>, :c_0fab0ef9;
  skos:exactMatch <http://vocab.getty.edu/aat/300404024> .

:c_db7df3e1 a skos:Concept;
  skos:definition "Objects purposely combined to be used as group. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "set"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024>, :c_0fab0ef9;
  skos:exactMatch <http://vocab.getty.edu/aat/300133146> .

:c_e6cf20b1 a skos:Concept;
  skos:definition "The outcropping, heavily weathered part of a mineralisation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "gossan"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000019>, :c_0fab0ef9, :c_888076c5;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-expression/gossan>,
    <https://www.wikidata.org/wiki/Q639293> .

:c_b81f7872 a skos:Concept;
  skos:definition "A rock whose chemical or mineralogical composition is changed by hydrothermal solutions. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "alteration product (hydrothermal)"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000003>, :c_0fab0ef9, :c_d5356583;
  skos:broadMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product> .

:c_f4468f4e a skos:Concept;
  skos:definition "A rock whose chemical or mineralogical composition is changed by weathering. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "alteration product (supergene)"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000003>, :c_0fab0ef9, :c_d5356583;
  skos:broadMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/alteration-product> .

:c_9c0fc70d a skos:Concept;
  skos:definition "The country rock or rock body in which a mineralisation occurs."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "host rock"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000003>, :c_0fab0ef9, :c_888076c5,
    :c_235c43fb;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/host-rock> .

:c_4dffb82b a skos:Concept;
  skos:definition "The material that is extracted from a mineralisation because of its economic value."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ore"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000003>, :c_0fab0ef9, :c_888076c5;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore>,
    <https://vocabs.acdh.oeaw.ac.at/oeai-materials/concept23771>, <http://resource.geosciml.org/classifier/cgi/raw-material-role/ore>,
    <http://vocab.getty.edu/aat/300152583> .

:c_1823779e a skos:Concept;
  skos:definition "The material that is extracted from a mineralisation because of its economic value that was not altered by hydrothermal processes or weathering. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "primary ore"@en;
  skos:broader :c_4dffb82b;
  skos:broadMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore> .

:c_adc64d1b a skos:Concept;
  skos:definition "The material that is extracted from a mineralisation because of its economic value that was altered by hydrothermal processes or weathering. The term usually refers to ore that became enriched in the targeted elements because of alteration processes. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "secondary ore"@en;
  skos:broader :c_4dffb82b;
  skos:broadMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/ore> .

:c_25814b64 a skos:Concept;
  skos:definition "The section of the host rock that was affected by epigenetic processes resulting in the mineralisation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "wall rock"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000003>, :c_0fab0ef9, :c_888076c5;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/earth-resource-material-role/wall-rock> .

:c_e95a9fbf a skos:Concept;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "discovery activity"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000023>;
  skos:relatedMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/147298>, <http://purl.org/heritagedata/schemes/agl_et/concepts/147297> .

:c_84c6c6e0 a skos:Concept;
  skos:definition "The incidental discovery (and recovery) of materials of interest. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "stray find"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/146344> .

:c_eb09b8cd a skos:Concept;
  skos:definition "Drilling into the ground with the aim to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "borehole survey"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145112> .

:c_410a0d02 a skos:Concept;
  skos:definition "Drilling into the ground with the aim to retrieve the content of the borehole as a whole. The material will subsequently be used to collect samples and/or to describe the stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "core drilling"@en;
  skos:broader :c_eb09b8cd;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/core-drilling>,
    <http://inspire.ec.europa.eu/codelist/ExplorationActivityTypeValue/coreDrilling> .

:c_19639bab a skos:Concept;
  skos:definition "Drilling into the ground with the aim to retrieve the content of the borehole as loose material to retrieve samples. In some cases, it can be used to infer stratigraphy and subsurface features of archaeological and geological features."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "auger drilling"@en;
  skos:broader :c_eb09b8cd;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/auger-drilling>,
    <http://purl.org/heritagedata/schemes/agl_et/concepts/145111> .

:c_3f471934 a skos:Concept;
  skos:definition "The use of a metal detector to discover artefacts. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "metal detecting"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <https://www.wikidata.org/wiki/Q111047657>;
  skos:closeMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145147>, <http://purl.org/heritagedata/schemes/agl_et/concepts/145148> .

:c_cd2a7865 a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an site and to retrieve samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "excavation"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145129>, <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/excavation>,
    <http://vocab.getty.edu/aat/300266151>;
  skos:closeMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145160> .

:c_8eff20cd a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to answer a specific research question by recording an site and retrieving samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "research excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/147305> .

:c_f39b79f2 a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an site under threat of destruction and to retrieve samples and artefacts from the site under strict time constraints. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "rescue excavation"@en;
  skos:altLabel "salvage excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/145157>, <https://www.wikidata.org/wiki/Q101008619> .

:c_6a6e0a7f a skos:Concept;
  skos:definition "Controlled and documented intrusive fieldwork with the aim to record an underwater site and to retrieve samples and artefacts from the site. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "underwater excavation"@en;
  skos:broader :c_cd2a7865;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/163244> .

:c_ae4a0583 a skos:Concept;
  skos:definition "Non-intrusive fieldwork to document the extent and layout of a site through recording the position and distribution of specimens and artefacts."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "survey"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://purl.org/heritagedata/schemes/agl_et/concepts/170654> .

:c_2758f3b1 a skos:Concept;
  skos:definition "The economic extraction of georesources from the earth. This includes surface and underground operations. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mining"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mining-activity>, <https://www.wikidata.org/wiki/Q44497> .

:c_77f07bb9 a skos:Concept;
  skos:definition "Mining activities in preparation to establishing a full-scale mining operation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "explorative mining activities"@en;
  skos:broader :c_e95a9fbf;
  skos:closeMatch <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/mine-workings-reconnaissance>,
    <http://resource.geosciml.org/classifier/cgi/exploration-activity-type/mining-pilot> .

:c_074a675c a skos:Concept;
  skos:definition "The systematic survey on an area with the aim to identify the presence of potentially economically viable mineralisations. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ore prospection"@en;
  skos:broader :c_e95a9fbf .

:c_d0e965f6 a skos:Concept;
  skos:definition "Uncontrolled and usually undocumented intrusive fieldwork with the aim to collected artefacts. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "illicit digging"@en;
  skos:altLabel "looting"@en;
  skos:broader :c_e95a9fbf;
  skos:exactMatch <https://www.wikidata.org/wiki/Q15624851> .

:c_ca223f0b a skos:Concept;
  skos:definition "Information about whether an (archaeological) context includes material from a single depositional event and whether the context is impacted by any post-depositional processes. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "context type"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000024> .

:c_0541320f a skos:Concept;
  skos:definition "The context represents a single depositional event with all material coming from the same source and no interaction happening after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "undisturbed context"@en;
  skos:altLabel "primary context"@en;
  skos:broader :c_ca223f0b;
  skos:closeMatch <https://www.wikidata.org/wiki/Q136826284> .

:c_0faa6b29 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "disturbed context"@en;
  skos:altLabel "secondary context"@en;
  skos:broader :c_ca223f0b;
  skos:closeMatch <https://www.wikidata.org/wiki/Q136826785> .

:c_9408f513 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with humans being the responsible agents. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "anthropogenically disturbed"@en;
  skos:broader :c_0faa6b29 .

:c_1c4bfb96 a skos:Concept;
  skos:definition "The material in the context represents multiple depositional events or it was interacted with non-humans being the responsible agents (e.g. bioturbidation)."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "biogenically disturbed"@en;
  skos:broader :c_0faa6b29 .

:c_a0ae7ce8 a skos:Concept;
  skos:definition "The context represents a single depositional event with material coming from multiple sources and no interaction happening after its deposition. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "mixed context"@en;
  skos:broader :c_ca223f0b .

:c_b53eb953 a skos:Concept;
  skos:definition "The material the object is stored in. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "sample housing"@en;
  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000017> .

:c_1a3ca880 a skos:Concept;
  skos:definition "A container made of thick stiff pasteboard with either a lid or a foldable parts on its top for closing it. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "cardboard box"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300215468>, <http://vocab.getty.edu/aat/300200342> .

:c_6fedae89 a skos:Concept;
  skos:definition "A cardboard box certified to be acid free. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "acid-free cardboard box"@en;
  skos:broader :c_1a3ca880 .

:c_ae7c0b8c a skos:Concept;
  skos:definition "A cardboard box not certified to be acid free. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "non acid-free cardboard box"@en;
  skos:broader :c_1a3ca880 .

:c_518ec832 a skos:Concept;
  skos:definition "A tube with a hinged sealing cap made of (shatterproof) plastics. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Eppendorf tube"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300198822>;
  skos:exactMatch <https://www.wikidata.org/wiki/Q1933961> .

:c_e7fdebfb a skos:Concept;
  skos:definition "A vial made of glass and closed with a lid, often made of plastics. They come in various shapes and sizes and with various types of lids. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "glass vial"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300198822> .

:c_3bb341cf a skos:Concept;
  skos:definition "A vial with lid made of PTFE or Teflon. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "PTFE/Teflon vial"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300198822> .

:c_0e85ae39 a skos:Concept;
  skos:definition "The objects are not stored in a container, usually because of their size and/or weight. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "no housing"@en;
  skos:broader :c_b53eb953 .

:c_f641a35c a skos:Concept;
  skos:definition "A usually non-sealable flexible container made of plastics. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "plastics bag"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300194509> .

:c_cbbc3d94 a skos:Concept;
  skos:definition "A flexible container made of woven material. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "fabric bag"@en;
  skos:broader :c_b53eb953;
  skos:broadMatch <http://vocab.getty.edu/aat/300194509> .

