  skos:broader <https://vocabs.dariah.eu/bbt/Concept/000022>;
  skos:exactMatch <https://www.wikidata.org/wiki/Q19386377> .

:c_59d96666 a skos:Concept;
  skos:definition "A service publishing structured authoritative information about a certain topic, usually locations, based on ontological principles. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "gazetteer"@en;
  skos:broader :c_062fe0b0;
  skos:exactMatch <https://www.wikidata.org/wiki/Q81661634>;
  skos:closeMatch <https://www.wikidata.org/wiki/Q1006160> .

:c_321798be a skos:Concept;
