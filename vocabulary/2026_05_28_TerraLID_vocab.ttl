  skos:broader :c_3ba0ff02 .

:c_bb54a1e5 a skos:Concept;
  skos:definition "The material has only surficial or spatially very limited corrosion. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "weak corrosion"@en;
  skos:broader :c_3ba0ff02 .

:c_16a7b2ad a skos:Concept;
  skos:definition "The material does not show any indication of corrosion. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "no corrosion"@en;
  skos:broader :c_3ba0ff02 .

