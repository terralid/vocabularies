  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#dataset> .

:c_b3d49316 a skos:Concept;
  skos:definition "A factual and objective publication with a focused intent to identify and describe specific data, sets of data, or data collections to facilitate discoverability."@en;
  skos:scopeNote "A data paper describes data provenance and methodologies used in the gathering, processing, organizing, and representing the data."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "DataPaper"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q17009938>;
