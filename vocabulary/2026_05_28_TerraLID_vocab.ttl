  skos:topConceptOf :conceptScheme_a0559f69;
  skos:prefLabel "corrosion extent"@en .

:c_372633f8 a skos:Concept;
  skos:definition "The material consists mostly of corrosion products and it requires close observation to find uncorroded material. "@en;
