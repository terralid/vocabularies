  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "slight alteration"@en;
  skos:broader :c_4e14cebd .

:c_eb1223d0 a skos:Concept;
  skos:definition "The material does not show any indication of alteration. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "no alteration"@en;
  skos:broader :c_4e14cebd .

:c_f5cb57a0 a skos:Concept;
