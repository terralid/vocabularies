:c_76209e5e a skos:Concept;
  skos:definition "An aggregation of resources, which may encompass collections of one resourceType as well as those of mixed types. A collection is described as a group; its parts may also be separately described."@en;
  skos:scopeNote "A collection of samples, or various files making up a report"@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "Collection"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#collection> .

:c_fc66bc62 a skos:Concept;
  skos:definition "One of the main divisions of a book."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "BookChapter"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
