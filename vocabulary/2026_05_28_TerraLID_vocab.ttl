:c_afd22872 a skos:Concept;
  skos:definition "Article that is written with the goal of being accepted to a conference."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ConferencePaper"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
  skos:broader :c_4f75cdd5;
  skos:exactMatch <https://www.wikidata.org/wiki/Q23927052>;
  dct:references <https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#conferencepaper> .

:c_0afde725 a skos:Concept;
  skos:definition "A virtual notebook environment used for literate programming."@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "ComputationalNotebook"@en;
  skos:note "The name and definition of this entry are taken from the DataCite Metadata Schema v4.7, published under a Creative Commons Attribution 4.0 (CC-BY 4.0) International license. "@en;
