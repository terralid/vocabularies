  skos:broader :c_cb977df5;
  dct:references <https://tsapps.nist.gov/srmext/certificates/612.pdf> .

:c_1d25bfbf a skos:Concept;
  skos:definition "Trace element CRM prepared from synthetic glass used for the measurement of lead isotope ratios with laser ablation. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "NIST SRM 614"@en;
  skos:broader :c_cb977df5;
  dct:references <https://tsapps.nist.gov/srmext/certificates/614.pdf> .

