:c_14f0b363 a skos:Concept;
  skos:definition "The measurement of the released stored energy in a material in the form of light to determine the material's age. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "luminescence dating"@en;
  skos:broader :c_70421df0;
