  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "field"@en;
  skos:broader :c_823bba89;
  skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mineral-occurrence-type/field> .

:c_b01341cd a skos:Concept;
