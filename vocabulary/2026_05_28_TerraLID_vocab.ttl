:c_ef46e5df a skos:Concept;
  skos:definition "The Gemeinsame Normdatei (GND, Integrated Authority File) of the German National Library provides authoritative data on a wide range of topics, among them persons, corporate bodies and geographic entities. Its main target groups are libraries who used it for cataloguing their publication. "@en;
  skos:inScheme :conceptScheme_a0559f69;
  skos:prefLabel "GND"@en;
