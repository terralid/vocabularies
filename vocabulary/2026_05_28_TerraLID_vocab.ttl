  dct:dateSubmitted "2015-08-13T07:33:06Z" .

<https://vocabs.dariah.eu/bbt/ConceptScheme/Backbone_Thesaurus> a skos:ConceptScheme;
  rdfs:label "Backbone Thesaurus";
  owl:versionInfo "2";
  dct:title "Backbone Thesaurus"@en;
  dct:description "The BBT is the research outcome of work undertaken by the DARIAH Thesaurus Maintenance WG in an effort to design and establish a coherent overarching thesaurus for the humanities, under which specialist thesauri and structured vocabularies used across scholarly communities can be aligned and form a thesaurus federation.  It aims at enabling cross-disciplinary resource discovery while ensuring compatibility with thesauri that cover highly specific scientific domains and areas of knowledge in development.  The BBT was created and funded by the DARIAH GR Developing a Greek Research Infrastructure for the Humanities project (2013-2015). Currently it receives funding by the APOLLONIS Greek Infrastructure for Humanities, Arts and Language Research and Innovation project (2017-2020)."@en;
  dct:creator "BBT maintenance WG"@en, "Annika Kirschenede"@en, "Bruno Almeida"@en,
    "Lena Vitt"@en, "Lida Charami"@en, "Helen Goulis"@en, "Maria Daskalaki"@en, "Eleni Tsouloucha"@en,
    "Evelyne Sinigaglia"@en, "Martin Doerr"@en, "Helen Katsiadaki"@en, "Chryssoula Bekiari"@en,
    "Camilla Colombi"@en, "Hella Hollander"@en, "Wolfgang Schmidle"@en, "Iraklitos Souyioultzoglou"@en,
    "George Bruseker"@en, "Gerasimos Chrysovitsanos"@en, "Yorgos Tzedopoulos"@en, "Patricia Kalafata"@en,
    "Georgia Papadopoulou"@en, "Blandine Nouvel"@en, "Athina Kritsotaki"@en, "Vanessa Hannesschläger"@en;
  skos:hasTopConcept <https://vocabs.dariah.eu/bbt/Concept/000002>, <https://vocabs.dariah.eu/bbt/Concept/000006>,
    <https://vocabs.dariah.eu/bbt/Concept/000003>, <https://vocabs.dariah.eu/bbt/Concept/000005>,
    <https://vocabs.dariah.eu/bbt/Concept/>, <https://vocabs.dariah.eu/bbt/Concept/000001>,
    <https://vocabs.dariah.eu/bbt/Concept/000004>, <https://vocabs.dariah.eu/bbt/Concept/000009>,
    <https://vocabs.dariah.eu/bbt/Concept/0000049>;
  dct:created "2015-07-01T12:00:00Z";
  dct:modified "2024-02-26T13:20:33Z";
  dct:subject "conceptual objects"@en, "materials"@en, "roles"@en, "processes"@en, "activities"@en,
    "geopolitical units"@en, "humanities"@en;
